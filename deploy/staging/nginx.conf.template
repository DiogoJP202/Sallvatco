worker_processes auto;
pid /tmp/nginx.pid;
# Access log sem URLs/queries/credenciais; erros críticos exigem acesso restrito.
error_log /dev/stderr crit;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    log_format sanitized '$status $request_time';
    access_log /dev/stdout sanitized;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    client_max_body_size 11m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    send_timeout 30s;
    keepalive_timeout 30s;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    resolver 127.0.0.11 valid=10s ipv6=off;

    server {
        listen 8080 default_server;
        server_name _;
        return 444;
    }
    server {
        listen 8080;
        server_name ${STAGING_HOST};
        # Host fixo: não refletir Host fornecido pelo cliente no redirect.
        return 308 https://${STAGING_HOST}$request_uri;
    }
    server {
        listen 8443 ssl default_server;
        server_name _;
        ssl_reject_handshake on;
        return 444;
    }
    server {
        listen 8443 ssl;
        server_name ${STAGING_HOST};
        ssl_certificate /run/secrets/tls_certificate;
        ssl_certificate_key /run/secrets/tls_key;
        auth_basic 'Homologacao privada';
        auth_basic_user_file /run/secrets/access_passwords;
        add_header X-Robots-Tag 'noindex, nofollow, noarchive' always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security 'max-age=86400' always;
        # HSTS curto e sem includeSubDomains; promoção depende do domínio real.
        location = /health { return 404; }
        location ^~ /health/ { return 404; }
        location / {
            set $backend web:8080;
            proxy_pass http://$backend;
            proxy_http_version 1.1;
            proxy_set_header Connection '';
            proxy_set_header Host ${STAGING_HOST};
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Host '';
            proxy_set_header Forwarded '';
            proxy_set_header CF-Connecting-IP '';
            proxy_set_header Authorization '';
            proxy_connect_timeout 5s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
            proxy_buffering off;
        }
    }
}
