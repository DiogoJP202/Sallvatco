<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="../Sallvat.Application/Sallvat.Application.csproj" />
    <ProjectReference Include="../Sallvat.Infrastructure/Sallvat.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>0b962ad5-fb2d-4c42-af82-f2cf18da2698</UserSecretsId>
    <FrontendRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</FrontendRoot>
  </PropertyGroup>

  <ItemGroup>
    <TailwindSource Include="Styles/app.css;Views/**/*.cshtml;Controllers/**/*.cs;Models/**/*.cs;../../package-lock.json" />
  </ItemGroup>

  <Target
    Name="BuildTailwindCss"
    BeforeTargets="PrepareForBuild"
    Inputs="@(TailwindSource)"
    Outputs="$(MSBuildProjectDirectory)/wwwroot/css/app.css"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <Error
      Condition="!Exists('$(FrontendRoot)/node_modules/@tailwindcss/cli/package.json')"
      Text="Dependências frontend ausentes. Execute 'npm ci' na raiz do repositório." />
    <Exec Command="npm run css:build" WorkingDirectory="$(FrontendRoot)" />
  </Target>

</Project>
