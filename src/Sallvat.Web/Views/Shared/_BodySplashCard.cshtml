@model BodySplashPresentation
@{
    var thumbnailUrl = Url.Content(
        $"~/images/showcase/packshots/body-{Model.ImageSlug}-thumb.webp");
    var largeUrl = Url.Content(
        $"~/images/showcase/packshots/body-{Model.ImageSlug}.webp");
}

<article class="group overflow-hidden rounded-[2rem] bg-white text-ink shadow-sm ring-1 ring-stone-300/80 transition duration-500 hover:-translate-y-1 hover:shadow-xl hover:shadow-black/10"
         data-body-splash-card>
    <div class="relative overflow-hidden bg-[#f2ece3]">
        <img class="aspect-[4/5] w-full object-contain transition duration-700 group-hover:scale-[1.015]"
             src="@thumbnailUrl"
             srcset="@thumbnailUrl 480w, @largeUrl 1120w"
             sizes="(min-width: 1280px) 382px, (min-width: 1024px) calc((100vw - 136px) / 3), (min-width: 640px) calc((100vw - 92px) / 2), calc(100vw - 40px)"
             width="1120"
             height="1400"
             alt="Body splash @Model.Name da Sallvat & Co. sobre fundo claro, em imagem tratada para apresentação"
             loading="lazy"
             decoding="async" />
        <span class="absolute top-5 left-5 rounded-full bg-paper/90 px-4 py-2 text-[0.62rem] font-semibold tracking-[0.18em] text-ink uppercase backdrop-blur-sm">@BodySplashPresentation.VolumeMl ml</span>
    </div>
    <div class="p-6">
        <p class="text-[0.62rem] font-semibold tracking-[0.17em] text-copper uppercase">Body splash · @BodySplashPresentation.VolumeMl ml</p>
        <h3 class="mt-3 font-serif text-3xl leading-none">@Model.Name</h3>
        <p class="mt-3 text-sm leading-6 text-stone-600">@Model.Profile</p>
        <p class="mt-5 border-t border-stone-200 pt-4 text-sm"><span class="text-stone-500">Valor apresentado</span> <strong class="ml-2">@BodySplashPresentation.DisplayPrice.ToString("C")</strong></p>
    </div>
</article>
