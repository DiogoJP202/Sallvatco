@model CatalogProductSummary

<article class="group flex h-full flex-col overflow-hidden rounded-[2rem] bg-white shadow-sm ring-1 ring-stone-300/80 transition duration-500 hover:-translate-y-1 hover:shadow-xl hover:shadow-stone-900/10">
    <div class="relative overflow-hidden bg-sand">
        @if (Model.CoverImage is not null)
        {
            <img class="aspect-[4/5] w-full object-cover transition duration-700 group-hover:scale-[1.035]"
                 src="@Model.CoverImage.ThumbnailUrl"
                 srcset="@Model.CoverImage.ThumbnailUrl 480w, @Model.CoverImage.LargeUrl 1600w"
                 sizes="(min-width: 1280px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                 width="@Model.CoverImage.Width"
                 height="@Model.CoverImage.Height"
                 alt="@Model.CoverImage.AltText"
                 loading="lazy"
                 decoding="async" />
        }
        else
        {
            <div class="flex aspect-[4/5] items-center justify-center" aria-hidden="true">
                <span class="font-serif text-5xl text-copper/50">S&amp;Co.</span>
            </div>
        }
        <span class="absolute top-5 left-5 rounded-full bg-paper/90 px-4 py-2 text-[0.65rem] font-semibold tracking-[0.18em] text-ink uppercase backdrop-blur-sm">@Model.OlfactoryFamily</span>
    </div>
    <div class="flex flex-1 flex-col p-7">
        <h2 class="font-serif text-3xl leading-none">@Model.Name</h2>
        <p class="mt-4 line-clamp-2 flex-1 text-sm leading-6 text-stone-600">@Model.ShortDescription</p>
        <div class="mt-7 flex items-end justify-between gap-4 border-t border-stone-200 pt-5">
            <p><span class="block text-[0.62rem] font-semibold tracking-[0.16em] text-stone-500 uppercase">A partir de</span><strong class="mt-1 block text-sm">@Model.StartingPrice.ToString("C")</strong></p>
            <a class="inline-flex min-h-11 items-center gap-2 rounded-full border border-stone-300 px-4 py-2 text-sm font-semibold text-copper transition group-hover:border-copper group-hover:bg-copper group-hover:text-white"
               asp-controller="Perfumes"
               asp-action="Details"
               asp-route-slug="@Model.Slug">Conhecer <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</article>
