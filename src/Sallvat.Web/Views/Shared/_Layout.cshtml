@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostingEnvironment
@{
    var title = $"{ViewData["Title"] ?? "Sallvat & Co."} | Sallvat & Co.";
    var description = ViewData["Description"]?.ToString()
        ?? "Perfumaria Sallvat & Co. — uma experiência sensorial construída com cuidado.";
    var path = Context.Request.Path;
    var noIndex = !HostingEnvironment.IsProduction()
        || path.StartsWithSegments("/conta", StringComparison.OrdinalIgnoreCase)
        || path.StartsWithSegments("/Admin", StringComparison.OrdinalIgnoreCase)
        || path.StartsWithSegments("/carrinho", StringComparison.OrdinalIgnoreCase)
        || path.StartsWithSegments("/checkout", StringComparison.OrdinalIgnoreCase);
}
<!doctype html>
<html lang="pt-BR" class="h-full bg-paper">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <meta name="description" content="@description" />
    @if (noIndex)
    {
        <meta name="robots" content="noindex,nofollow" />
    }
    @if (ViewData["CanonicalUrl"] is string canonicalUrl)
    {
        <link rel="canonical" href="@canonicalUrl" />
        <meta property="og:site_name" content="Sallvat &amp; Co." />
        <meta property="og:locale" content="pt_BR" />
        <meta property="og:type" content="@(ViewData["OpenGraphType"] ?? "website")" />
        <meta property="og:title" content="@title" />
        <meta property="og:description" content="@description" />
        <meta property="og:url" content="@canonicalUrl" />
        @if (ViewData["OpenGraphImage"] is string openGraphImage)
        {
            <meta property="og:image" content="@openGraphImage" />
            <meta property="og:image:alt" content="@ViewData["OpenGraphImageAlt"]" />
            <meta property="og:image:width" content="@ViewData["OpenGraphImageWidth"]" />
            <meta property="og:image:height" content="@ViewData["OpenGraphImageHeight"]" />
            <meta name="twitter:card" content="summary_large_image" />
        }
    }
    @if (ViewData["StructuredData"] is string structuredData)
    {
        <script type="application/ld+json">@Html.Raw(structuredData)</script>
    }
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="min-h-full bg-paper text-ink antialiased">
    <a class="sr-only z-50 bg-white px-4 py-3 text-sm font-semibold focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
       href="#conteudo">
        Pular para o conteúdo
    </a>

    <div class="bg-ink px-5 py-2.5 text-center text-[0.62rem] font-semibold tracking-[0.19em] text-stone-200 uppercase">
        A coleção Sallvat &amp; Co. está ganhando forma
    </div>

    <header class="sticky top-0 z-40 border-b border-stone-300/70 bg-paper/90 backdrop-blur-lg">
        <div class="relative mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 py-4 sm:px-8 lg:px-10">
            <a class="group whitespace-nowrap"
               asp-controller="Home"
               asp-action="Index">
                <span class="block font-serif text-xl tracking-[0.12em] uppercase transition group-hover:text-copper sm:text-2xl">Sallvat &amp; Co.</span>
                <span class="mt-0.5 hidden text-[0.52rem] font-semibold tracking-[0.25em] text-stone-500 uppercase sm:block">Perfumes artesanais</span>
            </a>
            <nav class="hidden items-center gap-6 sm:flex" aria-label="Navegação principal">
                <a class="text-sm font-medium text-stone-700 transition hover:text-copper"
                   asp-controller="Home"
                   asp-action="Index">Início</a>
                <a class="text-sm font-medium text-stone-700 transition hover:text-copper"
                   asp-area=""
                   asp-controller="Perfumes"
                   asp-action="Index">Perfumes</a>
                <a class="text-sm font-medium text-stone-700 transition hover:text-copper"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="manifesto-title">Sobre</a>
                @if (User.Identity?.IsAuthenticated is true)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="hidden text-sm font-medium text-stone-700 transition hover:text-copper sm:inline"
                           asp-area="Admin"
                           asp-controller="Home"
                           asp-action="Index">Administração</a>
                    }
                    <a class="btn-secondary !min-h-9 !px-3 !py-2 !whitespace-nowrap sm:!px-4"
                       asp-area=""
                       asp-controller="Account"
                       asp-action="Index">Minha conta</a>
                    <form asp-area=""
                          asp-controller="Account"
                          asp-action="Logout"
                          method="post">
                        <button class="text-sm font-semibold text-stone-600 transition hover:text-copper"
                                type="submit">Sair</button>
                    </form>
                }
                else
                {
                    <a class="text-sm font-semibold text-stone-700 transition hover:text-copper"
                       asp-controller="Account"
                       asp-action="Login">Entrar</a>
                    <a class="btn-primary !min-h-9 !px-3 !py-2 !whitespace-nowrap sm:!px-4"
                       asp-controller="Account"
                       asp-action="Register">Criar conta</a>
                }
            </nav>

            <button class="flex min-h-11 items-center gap-3 rounded-full border border-stone-300 bg-white px-4 text-sm font-semibold text-ink sm:hidden"
                    type="button"
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                    data-menu-button>
                <span>Menu</span>
                <span class="grid gap-1" aria-hidden="true"><span class="block h-px w-4 bg-ink"></span><span class="block h-px w-4 bg-ink"></span></span>
            </button>

            <nav id="mobile-menu"
                 class="absolute inset-x-4 top-[calc(100%+0.5rem)] hidden rounded-3xl border border-stone-300 bg-paper p-4 shadow-2xl shadow-stone-900/15 sm:hidden"
                 aria-label="Navegação móvel"
                 data-mobile-menu>
                <div class="grid gap-1">
                    <a class="rounded-2xl px-4 py-3 text-sm font-semibold transition hover:bg-white" asp-controller="Home" asp-action="Index">Início</a>
                    <a class="rounded-2xl px-4 py-3 text-sm font-semibold transition hover:bg-white" asp-area="" asp-controller="Perfumes" asp-action="Index">Perfumes</a>
                    <a class="rounded-2xl px-4 py-3 text-sm font-semibold transition hover:bg-white" asp-controller="Home" asp-action="Index" asp-fragment="manifesto-title">Sobre</a>
                    @if (User.Identity?.IsAuthenticated is true)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="rounded-2xl px-4 py-3 text-sm font-semibold transition hover:bg-white" asp-area="Admin" asp-controller="Home" asp-action="Index">Administração</a>
                        }
                        <a class="rounded-2xl px-4 py-3 text-sm font-semibold transition hover:bg-white" asp-area="" asp-controller="Account" asp-action="Index">Minha conta</a>
                        <form class="mt-2 border-t border-stone-300 pt-3" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                            <button class="w-full rounded-2xl px-4 py-3 text-left text-sm font-semibold text-stone-600 transition hover:bg-white hover:text-copper" type="submit">Sair</button>
                        </form>
                    }
                    else
                    {
                        <div class="mt-2 grid grid-cols-2 gap-2 border-t border-stone-300 pt-3">
                            <a class="btn-secondary" asp-controller="Account" asp-action="Login">Entrar</a>
                            <a class="btn-primary" asp-controller="Account" asp-action="Register">Criar conta</a>
                        </div>
                    }
                </div>
            </nav>
        </div>
    </header>

    <main id="conteudo" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="border-t border-white/10 bg-ink text-stone-300">
        <div class="mx-auto grid max-w-7xl gap-12 px-5 py-14 sm:px-8 md:grid-cols-[1.4fr_0.6fr] lg:px-10 lg:py-20">
            <div>
                <p class="font-serif text-2xl tracking-[0.12em] text-white uppercase">Sallvat &amp; Co.</p>
                <p class="mt-5 max-w-lg font-serif text-3xl leading-tight text-stone-200">
                    Toda fragrância começa com uma história.
                </p>
                <p class="mt-5 max-w-md text-sm leading-6 text-stone-400">
                    Perfumaria artesanal em construção. Catálogo e vendas serão liberados após homologação.
                </p>
            </div>
            <div class="md:text-right">
                <nav class="flex flex-wrap gap-x-5 gap-y-3 md:justify-end" aria-label="Navegação do rodapé">
                    <a class="text-sm transition hover:text-white" asp-controller="Home" asp-action="Index">Início</a>
                    <a class="text-sm transition hover:text-white" asp-controller="Perfumes" asp-action="Index">Perfumes</a>
                    <a class="text-sm transition hover:text-white" asp-controller="Account" asp-action="Login">Minha conta</a>
                </nav>
                <p class="mt-10 text-[0.62rem] tracking-[0.18em] text-stone-500 uppercase">Ambiente de desenvolvimento</p>
                <p class="mt-3 text-sm">© @DateTime.UtcNow.Year Sallvat &amp; Co.</p>
            </div>
        </div>
    </footer>

    <script src="~/js/storefront.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
