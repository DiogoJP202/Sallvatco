<!doctype html>
<html lang="pt-BR" class="h-full bg-stone-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Sallvat &amp; Co.</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="min-h-full bg-stone-50 text-stone-950 antialiased">
    <a class="sr-only z-50 bg-white px-4 py-3 text-sm font-semibold focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
       href="#conteudo">
        Pular para o conteúdo
    </a>

    <header class="border-b border-stone-200 bg-white">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-5 lg:px-8">
            <a class="whitespace-nowrap text-lg font-semibold tracking-[0.14em] uppercase"
               asp-controller="Home"
               asp-action="Index">
                Sallvat &amp; Co.
            </a>
            <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-medium text-stone-600">
                Em desenvolvimento
            </span>
        </div>
    </header>

    <main id="conteudo" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="border-t border-stone-200 bg-white">
        <div class="mx-auto max-w-6xl px-6 py-8 text-sm text-stone-600 lg:px-8">
            <p>Sallvat &amp; Co. — fundação técnica do e-commerce.</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
