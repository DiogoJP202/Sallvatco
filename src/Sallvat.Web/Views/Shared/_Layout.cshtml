<!doctype html>
<html lang="pt-BR" class="h-full bg-paper">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Sallvat &amp; Co.</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Perfumaria Sallvat & Co. — uma experiência sensorial construída com cuidado.")" />
    @if (ViewData["CanonicalUrl"] is string canonicalUrl)
    {
        <link rel="canonical" href="@canonicalUrl" />
    }
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="min-h-full bg-paper text-ink antialiased">
    <a class="sr-only z-50 bg-white px-4 py-3 text-sm font-semibold focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
       href="#conteudo">
        Pular para o conteúdo
    </a>

    <header class="border-b border-stone-300/70 bg-paper/95">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 py-5 sm:px-8 lg:px-10">
            <a class="whitespace-nowrap font-serif text-xl tracking-[0.12em] uppercase sm:text-2xl"
               asp-controller="Home"
               asp-action="Index">
                Sallvat &amp; Co.
            </a>
            <nav class="flex items-center gap-3 sm:gap-6" aria-label="Navegação principal">
                <a class="hidden text-sm font-medium text-stone-700 transition hover:text-copper sm:inline"
                   asp-controller="Home"
                   asp-action="Index">Início</a>
                <a class="hidden text-sm font-medium text-stone-700 transition hover:text-copper sm:inline"
                   asp-area=""
                   asp-controller="Perfumes"
                   asp-action="Index">Perfumes</a>
                @if (User.Identity?.IsAuthenticated is true)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="hidden text-sm font-medium text-stone-700 transition hover:text-copper sm:inline"
                           asp-area="Admin"
                           asp-controller="Home"
                           asp-action="Index">Administração</a>
                    }
                    <a class="btn-secondary !min-h-9 !px-4 !py-2"
                       asp-area=""
                       asp-controller="Account"
                       asp-action="Index">Minha conta</a>
                    <form asp-area=""
                          asp-controller="Account"
                          asp-action="Logout"
                          method="post">
                        <button class="text-sm font-semibold text-stone-600 transition hover:text-copper"
                                type="submit">Sair</button>
                    </form>
                }
                else
                {
                    <a class="text-sm font-semibold text-stone-700 transition hover:text-copper"
                       asp-controller="Account"
                       asp-action="Login">Entrar</a>
                    <a class="btn-primary !min-h-9 !px-4 !py-2"
                       asp-controller="Account"
                       asp-action="Register">Criar conta</a>
                }
            </nav>
        </div>
    </header>

    <main id="conteudo" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="border-t border-stone-300/70 bg-ink text-stone-300">
        <div class="mx-auto grid max-w-7xl gap-8 px-5 py-12 sm:px-8 md:grid-cols-2 lg:px-10">
            <div>
                <p class="font-serif text-xl tracking-[0.12em] text-white uppercase">Sallvat &amp; Co.</p>
                <p class="mt-3 max-w-md text-sm leading-6 text-stone-400">
                    Perfumaria em construção. Catálogo e vendas serão liberados após homologação.
                </p>
            </div>
            <div class="md:text-right">
                <p class="text-xs tracking-[0.18em] text-stone-500 uppercase">Ambiente de desenvolvimento</p>
                <p class="mt-3 text-sm">© @DateTime.UtcNow.Year Sallvat &amp; Co.</p>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
