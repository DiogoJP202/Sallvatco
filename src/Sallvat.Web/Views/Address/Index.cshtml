@model IReadOnlyList<Sallvat.Application.Accounts.AccountAddress>
@{
    ViewData["Title"] = "Endereços";
}

<section class="mx-auto max-w-7xl px-5 py-12 sm:px-8 lg:px-10 lg:py-16">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-5">
        <div>
            <p class="eyebrow">Área do cliente</p>
            <h1 class="mt-4 font-serif text-4xl sm:text-5xl">Endereços</h1>
        </div>
        <a class="btn-primary" asp-action="Create">Adicionar endereço</a>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="mb-8 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800" role="status">
            @statusMessage
        </div>
    }

    <div class="grid gap-8 lg:grid-cols-[15rem_minmax(0,1fr)]">
        <partial name="_AccountNavigation" />
        <div>
            @if (Model.Count == 0)
            {
                <div class="rounded-3xl border border-dashed border-stone-300 bg-white p-10 text-center sm:p-16">
                    <p class="font-serif text-3xl">Nenhum endereço salvo.</p>
                    <p class="mt-4 text-stone-600">Adicione um endereço para agilizar seu futuro checkout.</p>
                    <a class="btn-secondary mt-7" asp-action="Create">Adicionar o primeiro</a>
                </div>
            }
            else
            {
                <div class="grid gap-5 md:grid-cols-2">
                    @foreach (var address in Model)
                    {
                        <article class="rounded-3xl border border-stone-300 bg-white p-6">
                            <p class="eyebrow">@address.Label</p>
                            <h2 class="mt-3 font-serif text-2xl">@address.RecipientName</h2>
                            <address class="mt-4 text-sm leading-6 text-stone-600 not-italic">
                                @address.Street, @address.Number<br />
                                @if (!string.IsNullOrWhiteSpace(address.Complement))
                                {
                                    @address.Complement<br />
                                }
                                @address.District — @address.City/@address.StateCode<br />
                                CEP @address.PostalCode
                            </address>
                            <div class="mt-6 flex items-center gap-4 border-t border-stone-200 pt-5">
                                <a class="text-sm font-semibold text-copper hover:underline"
                                   asp-action="Edit"
                                   asp-route-id="@address.Id">Editar</a>
                                <form asp-action="Delete" asp-route-id="@address.Id" method="post">
                                    <button class="text-sm font-semibold text-red-700 hover:underline" type="submit">Remover</button>
                                </form>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </div>
</section>
