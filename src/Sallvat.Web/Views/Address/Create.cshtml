@model AddressViewModel
@{
    ViewData["Title"] = "Adicionar endereço";
}

<section class="mx-auto max-w-4xl px-5 py-12 sm:px-8 lg:py-16">
    <a class="text-sm font-semibold text-copper hover:underline" asp-action="Index">← Voltar para endereços</a>
    <div class="mt-7 rounded-3xl border border-stone-300 bg-white p-6 sm:p-9">
        <p class="eyebrow">Novo endereço</p>
        <h1 class="mt-4 font-serif text-4xl">Onde você deseja receber?</h1>
        <p class="mt-3 text-sm leading-6 text-stone-600">O CPF não é solicitado nesta etapa.</p>
        <form class="mt-8 space-y-7" asp-action="Create" method="post">
            <partial name="_Form" model="Model" />
            <div class="flex flex-wrap gap-3 border-t border-stone-200 pt-7">
                <button class="btn-primary" type="submit">Salvar endereço</button>
                <a class="btn-secondary" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</section>
