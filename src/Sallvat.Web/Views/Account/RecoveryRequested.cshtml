@{
    ViewData["Title"] = "Solicitação recebida";
}

<section class="mx-auto flex min-h-[64vh] max-w-3xl items-center px-5 py-16 sm:px-8">
    <div class="w-full rounded-3xl border border-stone-300 bg-white p-8 text-center shadow-xl shadow-stone-900/5 sm:p-12">
        <p class="eyebrow">Solicitação recebida</p>
        <h1 class="mt-5 font-serif text-4xl">Confira sua caixa de entrada.</h1>
        <p class="mx-auto mt-5 max-w-xl leading-7 text-stone-600">Se houver uma conta confirmada para o e-mail informado, as instruções serão enviadas. O link expira em três horas.</p>
        <a class="btn-primary mt-8" asp-action="Login">Voltar para o acesso</a>
    </div>
</section>
