@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Redefinir senha";
}

<section class="mx-auto flex min-h-[64vh] max-w-xl items-center px-5 py-16 sm:px-8">
    <div class="w-full rounded-3xl border border-stone-300 bg-white p-7 shadow-xl shadow-stone-900/5 sm:p-10">
        <p class="eyebrow">Nova senha</p>
        <h1 class="mt-4 font-serif text-4xl">Redefina seu acesso.</h1>
        <form class="mt-8 space-y-5" asp-action="ResetPassword" method="post">
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Code" type="hidden" />
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <label class="form-label" asp-for="Password"></label>
                <input class="form-control" asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password"></span>
            </div>
            <div>
                <label class="form-label" asp-for="ConfirmPassword"></label>
                <input class="form-control" asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
            <button class="btn-primary w-full" type="submit">Salvar nova senha</button>
        </form>
    </div>
</section>
