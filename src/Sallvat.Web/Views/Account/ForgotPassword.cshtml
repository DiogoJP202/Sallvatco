@model EmailViewModel
@{
    ViewData["Title"] = "Recuperar senha";
}

<section class="mx-auto flex min-h-[64vh] max-w-xl items-center px-5 py-16 sm:px-8">
    <div class="w-full rounded-3xl border border-stone-300 bg-white p-7 shadow-xl shadow-stone-900/5 sm:p-10">
        <p class="eyebrow">Recuperação de acesso</p>
        <h1 class="mt-4 font-serif text-4xl">Esqueceu sua senha?</h1>
        <p class="mt-4 leading-7 text-stone-600">Informe seu e-mail. Se houver uma conta confirmada, enviaremos um link válido por tempo limitado.</p>
        <form class="mt-8 space-y-5" asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <label class="form-label" asp-for="Email"></label>
                <input class="form-control" asp-for="Email" autocomplete="email" inputmode="email" />
                <span asp-validation-for="Email"></span>
            </div>
            <button class="btn-primary w-full" type="submit">Enviar instruções</button>
        </form>
        <p class="mt-6 text-center text-sm"><a class="font-semibold text-copper hover:underline" asp-action="Login">Voltar para o acesso</a></p>
    </div>
</section>
