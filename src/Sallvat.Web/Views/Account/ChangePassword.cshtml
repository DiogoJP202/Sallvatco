@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Segurança";
}

<section class="mx-auto max-w-7xl px-5 py-12 sm:px-8 lg:px-10 lg:py-16">
    <div class="mb-10">
        <p class="eyebrow">Área do cliente</p>
        <h1 class="mt-4 font-serif text-4xl sm:text-5xl">Segurança</h1>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="mb-8 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800" role="status">
            @statusMessage
        </div>
    }

    <div class="grid gap-8 lg:grid-cols-[15rem_minmax(0,1fr)]">
        <partial name="_AccountNavigation" />
        <div class="rounded-3xl border border-stone-300 bg-white p-6 sm:p-9">
            <h2 class="font-serif text-3xl">Alterar senha</h2>
            <p class="mt-2 max-w-xl text-sm leading-6 text-stone-600">Ao concluir, a sessão atual será renovada e credenciais antigas deixarão de funcionar.</p>
            <form class="mt-8 max-w-xl space-y-5" asp-action="ChangePassword" method="post">
                <div asp-validation-summary="ModelOnly"></div>
                <div>
                    <label class="form-label" asp-for="CurrentPassword"></label>
                    <input class="form-control" asp-for="CurrentPassword" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="NewPassword"></label>
                    <input class="form-control" asp-for="NewPassword" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="ConfirmPassword"></label>
                    <input class="form-control" asp-for="ConfirmPassword" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>
                <button class="btn-primary" type="submit">Alterar senha</button>
            </form>
        </div>
    </div>
</section>
