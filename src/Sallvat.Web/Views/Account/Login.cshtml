@model LoginViewModel
@{
    ViewData["Title"] = "Entrar";
}

<section class="mx-auto grid min-h-[66vh] max-w-7xl items-center gap-12 px-5 py-14 sm:px-8 lg:grid-cols-2 lg:px-10 lg:py-20">
    <div class="max-w-lg">
        <p class="eyebrow">Bem-vindo de volta</p>
        <h1 class="mt-5 font-serif text-5xl leading-tight">Entre em sua conta.</h1>
        <p class="mt-6 text-lg leading-8 text-stone-600">Gerencie seus dados, endereços e, em breve, acompanhe seus pedidos em um só lugar.</p>
    </div>

    <div class="w-full max-w-lg rounded-3xl border border-stone-300 bg-white p-6 shadow-xl shadow-stone-900/5 sm:p-9 lg:justify-self-end">
        <h2 class="font-serif text-3xl">Acessar</h2>
        <form class="mt-8 space-y-5" asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <label class="form-label" asp-for="Email"></label>
                <input class="form-control" asp-for="Email" autocomplete="email" inputmode="email" />
                <span asp-validation-for="Email"></span>
            </div>
            <div>
                <div class="flex items-center justify-between gap-4">
                    <label class="form-label" asp-for="Password"></label>
                    <a class="mb-2 text-xs font-semibold text-copper underline-offset-4 hover:underline" asp-action="ForgotPassword">Esqueci minha senha</a>
                </div>
                <input class="form-control" asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>
            <label class="flex items-center gap-3 text-sm text-stone-600">
                <input class="h-4 w-4 rounded border-stone-300 text-copper" asp-for="RememberMe" />
                <span>Manter acesso neste dispositivo</span>
            </label>
            <button class="btn-primary w-full" type="submit">Entrar</button>
        </form>
        <div class="mt-7 space-y-2 text-center text-sm text-stone-600">
            <p>Primeiro acesso? <a class="font-semibold text-copper hover:underline" asp-action="Register">Criar conta</a></p>
            <p>Não recebeu a confirmação? <a class="font-semibold text-copper hover:underline" asp-action="ResendConfirmation">Reenviar e-mail</a></p>
        </div>
    </div>
</section>
