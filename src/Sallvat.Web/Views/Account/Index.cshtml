@model ProfileViewModel
@{
    ViewData["Title"] = "Minha conta";
}

<section class="mx-auto max-w-7xl px-5 py-12 sm:px-8 lg:px-10 lg:py-16">
    <div class="mb-10">
        <p class="eyebrow">Área do cliente</p>
        <h1 class="mt-4 font-serif text-4xl sm:text-5xl">Minha conta</h1>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="mb-8 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800" role="status">
            @statusMessage
        </div>
    }

    <div class="grid gap-8 lg:grid-cols-[15rem_minmax(0,1fr)]">
        <partial name="_AccountNavigation" />

        <div class="rounded-3xl border border-stone-300 bg-white p-6 sm:p-9">
            <div class="flex flex-wrap items-start justify-between gap-4 border-b border-stone-200 pb-6">
                <div>
                    <h2 class="font-serif text-3xl">Dados pessoais</h2>
                    <p class="mt-2 text-sm leading-6 text-stone-600">Use apenas dados necessários para contato e entrega.</p>
                </div>
                <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-800">
                    E-mail confirmado
                </span>
            </div>

            <form class="mt-8 max-w-2xl space-y-5" asp-action="UpdateProfile" method="post">
                <div asp-validation-summary="ModelOnly"></div>
                <div>
                    <label class="form-label" asp-for="Name"></label>
                    <input class="form-control" asp-for="Name" autocomplete="name" />
                    <span asp-validation-for="Name"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="Email"></label>
                    <input class="form-control bg-stone-50 text-stone-500" asp-for="Email" autocomplete="email" readonly />
                    <p class="mt-2 text-xs text-stone-500">A alteração de e-mail exigirá um fluxo de confirmação próprio.</p>
                </div>
                <div>
                    <label class="form-label" asp-for="Phone"></label>
                    <input class="form-control" asp-for="Phone" autocomplete="tel" inputmode="tel" />
                    <span asp-validation-for="Phone"></span>
                </div>
                <button class="btn-primary" type="submit">Salvar alterações</button>
            </form>
        </div>
    </div>
</section>
