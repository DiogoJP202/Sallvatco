@{
    ViewData["Title"] = "Senha redefinida";
}

<section class="mx-auto flex min-h-[64vh] max-w-3xl items-center px-5 py-16 sm:px-8">
    <div class="w-full rounded-3xl border border-stone-300 bg-white p-8 text-center shadow-xl shadow-stone-900/5 sm:p-12">
        <p class="eyebrow">Tudo certo</p>
        <h1 class="mt-5 font-serif text-4xl">Sua senha foi redefinida.</h1>
        <p class="mx-auto mt-5 max-w-xl leading-7 text-stone-600">Use a nova senha para acessar sua conta.</p>
        <a class="btn-primary mt-8" asp-action="Login">Entrar</a>
    </div>
</section>
