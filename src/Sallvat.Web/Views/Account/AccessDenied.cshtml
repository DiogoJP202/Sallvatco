@{
    ViewData["Title"] = "Acesso negado";
}

<section class="mx-auto flex min-h-[64vh] max-w-3xl items-center px-5 py-16 sm:px-8">
    <div class="w-full rounded-3xl border border-stone-300 bg-white p-8 text-center shadow-xl shadow-stone-900/5 sm:p-12">
        <p class="eyebrow">Acesso restrito</p>
        <h1 class="mt-5 font-serif text-4xl">Você não pode acessar esta área.</h1>
        <p class="mx-auto mt-5 max-w-xl leading-7 text-stone-600">Se acredita que isso é um engano, entre novamente ou procure o canal oficial de suporte quando ele estiver disponível.</p>
        <a class="btn-primary mt-8" asp-controller="Home" asp-action="Index">Voltar ao início</a>
    </div>
</section>
