@model CartPageViewModel
@{
    ViewData["Title"] = "Sacola";
    ViewData["Description"] = "Revise as fragrâncias selecionadas e a disponibilidade atual.";
}

<section class="border-b border-stone-300/70 bg-[#e8ded0]">
    <div class="mx-auto max-w-7xl px-5 py-14 sm:px-8 lg:px-10 lg:py-20">
        <p class="eyebrow">Sua seleção</p>
        <div class="mt-5 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <h1 class="font-serif text-5xl leading-none tracking-tight sm:text-7xl">Sacola</h1>
                <p class="mt-5 max-w-2xl text-base leading-7 text-stone-600">Preço e estoque são conferidos novamente pelo servidor sempre que você abre ou altera esta página.</p>
            </div>
            @if (Model.Cart.Items.Count > 0)
            {
                <p class="text-sm text-stone-600">@Model.Cart.TotalQuantity @(Model.Cart.TotalQuantity == 1 ? "item selecionado" : "itens selecionados")</p>
            }
        </div>
    </div>
</section>

<section class="bg-paper">
    <div class="mx-auto max-w-7xl px-5 py-12 sm:px-8 lg:px-10 lg:py-20">
        @if (TempData["CartStatus"] is string statusMessage)
        {
            <div class="mb-8 rounded-2xl border border-emerald-700/20 bg-emerald-50 px-5 py-4 text-sm text-emerald-900" role="status">@statusMessage</div>
        }
        @if (TempData["CartError"] is string errorMessage)
        {
            <div class="mb-8 rounded-2xl border border-red-700/20 bg-red-50 px-5 py-4 text-sm text-red-900" role="alert">@errorMessage</div>
        }

        @if (Model.Cart.Items.Count == 0)
        {
            <div class="rounded-[2.5rem] border border-stone-300 bg-white px-6 py-16 text-center shadow-sm sm:px-12 sm:py-24">
                <p class="eyebrow">A próxima história</p>
                <h2 class="mt-5 font-serif text-4xl leading-tight sm:text-5xl">Sua sacola ainda está vazia.</h2>
                <p class="mx-auto mt-5 max-w-lg text-sm leading-7 text-stone-600">Explore a coleção e escolha a fragrância que combina com o momento que você quer criar.</p>
                <a class="btn-primary mt-8" asp-controller="Perfumes" asp-action="Index">Descobrir perfumes</a>
            </div>
        }
        else
        {
            <div class="grid gap-10 lg:grid-cols-[1fr_22rem] lg:items-start">
                <div class="grid gap-5">
                    @foreach (var item in Model.Cart.Items)
                    {
                        <article class="grid gap-5 rounded-[2rem] border border-stone-300 bg-white p-5 shadow-sm sm:grid-cols-[9rem_1fr] sm:p-6">
                            <a class="overflow-hidden rounded-2xl bg-sand" asp-controller="Perfumes" asp-action="Details" asp-route-slug="@item.ProductSlug">
                                @if (item.Image is not null)
                                {
                                    <img class="aspect-[4/5] h-full w-full object-cover" src="@item.Image.Url" width="@item.Image.Width" height="@item.Image.Height" alt="@item.Image.AltText" loading="lazy" decoding="async" />
                                }
                            </a>
                            <div class="flex min-w-0 flex-col">
                                <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                                    <div>
                                        <p class="text-[0.62rem] font-semibold tracking-[0.16em] text-stone-500 uppercase">@item.VolumeMl ml · @item.Sku</p>
                                        <h2 class="mt-2 font-serif text-3xl"><a class="transition hover:text-copper" asp-controller="Perfumes" asp-action="Details" asp-route-slug="@item.ProductSlug">@item.ProductName</a></h2>
                                    </div>
                                    <p class="font-serif text-2xl">@item.LineTotal.ToString("C")</p>
                                </div>

                                @if (item.PriceChanged)
                                {
                                    <p class="mt-4 rounded-xl bg-amber-50 px-4 py-3 text-xs leading-5 text-amber-900">O preço foi atualizado de @item.ReferenceUnitPrice.ToString("C") para @item.UnitPrice.ToString("C").</p>
                                }
                                @if (!item.IsAvailable)
                                {
                                    <p class="mt-4 rounded-xl bg-red-50 px-4 py-3 text-xs leading-5 text-red-900">Esta seleção precisa de atenção. Disponibilidade atual: @item.AvailableQuantity.</p>
                                }

                                <div class="mt-auto flex flex-col gap-3 pt-6 sm:flex-row sm:items-end sm:justify-between">
                                    <form class="flex items-end gap-3" asp-action="UpdateItem" asp-route-itemId="@item.ItemId" method="post">
                                        <label class="grid gap-1 text-xs font-semibold text-stone-600">
                                            Quantidade
                                            <input class="w-24 rounded-xl border border-stone-300 bg-paper px-3 py-2 text-base text-ink" name="Quantity" type="number" value="@item.Quantity" min="1" max="@CartLimits.MaximumQuantityPerItem" inputmode="numeric" />
                                        </label>
                                        <button class="btn-secondary !min-h-10 !px-4 !py-2" type="submit">Atualizar</button>
                                    </form>
                                    <form asp-action="RemoveItem" asp-route-itemId="@item.ItemId" method="post">
                                        <button class="text-sm font-semibold text-stone-500 underline decoration-stone-300 underline-offset-4 transition hover:text-red-800" type="submit">Remover</button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                <aside class="rounded-[2rem] bg-ink p-7 text-white shadow-xl lg:sticky lg:top-28">
                    <p class="text-[0.62rem] font-semibold tracking-[0.18em] text-stone-400 uppercase">Resumo atual</p>
                    <div class="mt-6 flex items-end justify-between gap-5 border-b border-white/15 pb-6">
                        <span class="text-sm text-stone-300">Subtotal</span>
                        <strong class="font-serif text-3xl">@Model.Cart.Subtotal.ToString("C")</strong>
                    </div>
                    <p class="mt-5 text-xs leading-5 text-stone-400">Frete, cupom e total final serão calculados nas próximas etapas do checkout.</p>
                    <button class="mt-7 min-h-12 w-full cursor-not-allowed rounded-full bg-stone-600 px-6 py-3 text-sm font-semibold text-stone-300" type="button" disabled>Checkout na próxima etapa</button>
                    <a class="mt-4 block text-center text-sm font-semibold text-stone-300 transition hover:text-white" asp-controller="Perfumes" asp-action="Index">Continuar escolhendo</a>
                    <form class="mt-7 border-t border-white/15 pt-6 text-center" asp-action="Clear" method="post">
                        <button class="text-xs font-semibold tracking-wide text-stone-400 uppercase transition hover:text-white" type="submit">Esvaziar sacola</button>
                    </form>
                </aside>
            </div>
        }
    </div>
</section>
