@{
    ViewData["Title"] = "Início";
}

<section class="mx-auto grid min-h-[68vh] max-w-6xl content-center gap-10 px-6 py-20 lg:grid-cols-[minmax(0,1fr)_20rem] lg:px-8">
    <div class="max-w-3xl">
        <p class="mb-5 text-sm font-semibold tracking-[0.18em] text-stone-500 uppercase">
            Perfumaria artesanal
        </p>
        <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
            Uma experiência de marca está sendo construída com cuidado.
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-stone-600">
            Esta página valida a fundação técnica do Sallvat &amp; Co. O catálogo,
            os textos e a identidade visual serão publicados somente após aprovação.
        </p>
    </div>

    <aside class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm" aria-labelledby="status-title">
        <h2 id="status-title" class="text-sm font-semibold tracking-wide text-stone-900 uppercase">
            Estado atual
        </h2>
        <p class="mt-3 text-sm leading-6 text-stone-600">
            Fundação técnica em desenvolvimento. Nenhuma compra pode ser realizada neste ambiente.
        </p>
    </aside>
</section>
