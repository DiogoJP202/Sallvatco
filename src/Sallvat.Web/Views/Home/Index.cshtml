@model HomePageViewModel
@{
    ViewData["Title"] = "Início";
    ViewData["Description"] = "Perfumes artesanais Sallvat & Co., apresentados com clareza, cuidado e identidade própria.";
}

<section class="relative isolate min-h-[calc(100svh-7.5rem)] overflow-hidden bg-ink text-white" aria-labelledby="hero-title">
    <img class="absolute inset-0 -z-20 h-full w-full object-cover object-[82%_center] sm:object-[68%_center]"
         src="~/images/home/hero-coastal.webp"
         asp-append-version="true"
         width="1536"
         height="1024"
         alt="Frasco de perfume em vidro sobre pedra clara diante do mar"
         decoding="async"
         fetchpriority="high" />
    <div class="absolute inset-0 -z-10 bg-black/55 sm:bg-gradient-to-r sm:from-black/85 sm:via-black/55 sm:to-black/5" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-48 bg-gradient-to-t from-black/45 to-transparent" aria-hidden="true"></div>

    <div class="mx-auto flex min-h-[calc(100svh-7.5rem)] max-w-7xl items-end px-5 py-16 sm:px-8 sm:py-20 lg:items-center lg:px-10">
        <div class="max-w-3xl">
            <p class="inline-flex items-center gap-3 text-xs font-semibold tracking-[0.24em] text-stone-100 uppercase">
                <span class="h-px w-10 bg-white/70" aria-hidden="true"></span>
                Perfumaria artesanal
            </p>
            <h1 id="hero-title" class="mt-7 max-w-3xl font-serif text-5xl leading-[0.92] tracking-[-0.035em] text-balance sm:text-7xl lg:text-[5.8rem]">
                Toda fragrância começa com uma história.
            </h1>
            <p class="mt-7 max-w-xl text-base leading-7 text-stone-100 sm:text-lg sm:leading-8">
                Conheça o catálogo Sallvat &amp; Co. e descubra perfumes artesanais pensados para transformar presença em memória.
            </p>
            <div class="mt-10 flex flex-wrap gap-3">
                <a class="inline-flex min-h-12 items-center justify-center rounded-full bg-white px-7 py-3 text-sm font-semibold text-ink transition hover:bg-sand"
                   asp-controller="Perfumes"
                   asp-action="Index">Descobrir a coleção</a>
                <a class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/60 bg-black/10 px-7 py-3 text-sm font-semibold text-white backdrop-blur-sm transition hover:border-white hover:bg-white/10"
                   href="#universos">Conhecer os universos</a>
            </div>
        </div>
    </div>

    <div class="absolute right-5 bottom-6 hidden items-center gap-3 text-[0.68rem] tracking-[0.22em] text-white/80 uppercase lg:flex" aria-hidden="true">
        <span>Deslize para descobrir</span>
        <span class="flex h-9 w-9 items-center justify-center rounded-full border border-white/40">↓</span>
    </div>
</section>

<section class="border-b border-stone-300/70 bg-ink text-stone-100" aria-label="Pilares da marca">
    <div class="mx-auto grid max-w-7xl divide-y divide-white/15 px-5 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-8 lg:px-10">
        <p class="py-5 text-center text-[0.68rem] font-semibold tracking-[0.2em] uppercase">Perfumes artesanais</p>
        <p class="py-5 text-center text-[0.68rem] font-semibold tracking-[0.2em] uppercase">Presença e personalidade</p>
        <p class="py-5 text-center text-[0.68rem] font-semibold tracking-[0.2em] uppercase">Uma história em cada frasco</p>
    </div>
</section>

@if (Model.FeaturedProducts.Count > 0)
{
    <section class="bg-paper" aria-labelledby="destaques-title">
        <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:px-10 lg:py-28">
            <div class="grid items-end gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
                <div>
                    <p class="eyebrow">Perfumes em destaque</p>
                    <h2 id="destaques-title" class="mt-5 max-w-3xl font-serif text-5xl leading-none tracking-tight sm:text-6xl">
                        Escolhas para deixar marca.
                    </h2>
                </div>
                <div class="lg:text-right">
                    <p class="text-sm leading-6 text-stone-600">Conheça fragrâncias publicadas pela curadoria e encontre a que conversa com o seu momento.</p>
                    <a class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-copper underline-offset-4 hover:underline"
                       asp-controller="Perfumes"
                       asp-action="Index">Ver catálogo completo <span aria-hidden="true">↗</span></a>
                </div>
            </div>
            <div class="mt-12 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var product in Model.FeaturedProducts)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </div>
    </section>
}

<section id="universos" class="bg-[#ddd2c4]" aria-labelledby="universos-title">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:px-10 lg:py-28">
        <div class="max-w-3xl">
            <p class="eyebrow">Universos olfativos</p>
            <h2 id="universos-title" class="mt-5 font-serif text-5xl leading-none tracking-tight sm:text-6xl">
                Quatro maneiras de ocupar o espaço.
            </h2>
        </div>

        <div class="mt-12 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
            <a class="group relative min-h-[31rem] overflow-hidden rounded-[2rem] bg-sand"
               asp-controller="Perfumes"
               asp-action="Index"
               asp-route-familia="Fresco aquático">
                <img class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]"
                     src="~/images/showcase/atmosphere-sea-salt.webp"
                     asp-append-version="true"
                     width="900"
                     height="1125"
                     alt="Cristais de sal sobre pedra clara diante do mar"
                     loading="lazy"
                     decoding="async" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent" aria-hidden="true"></div>
                <div class="absolute inset-x-0 bottom-0 p-7 text-white">
                    <p class="text-[0.68rem] font-semibold tracking-[0.22em] uppercase">Sea Salt · Mineral</p>
                    <h3 class="mt-3 font-serif text-4xl">Fresco</h3>
                    <p class="mt-3 text-sm leading-6 text-stone-100">Sal, transparência e uma sensação de horizonte aberto.</p>
                </div>
            </a>

            <a class="group relative min-h-[31rem] overflow-hidden rounded-[2rem] bg-ink"
               asp-controller="Perfumes"
               asp-action="Index"
               asp-route-familia="Âmbar gourmand">
                <img class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]"
                     src="~/images/showcase/atmosphere-hibernum.webp"
                     asp-append-version="true"
                     width="900"
                     height="1125"
                     alt="Baunilha, fava-tonka e resina âmbar sob luz quente"
                     loading="lazy"
                     decoding="async" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent" aria-hidden="true"></div>
                <div class="absolute inset-x-0 bottom-0 p-7 text-white">
                    <p class="text-[0.68rem] font-semibold tracking-[0.22em] uppercase">Hibernum · Envolvente</p>
                    <h3 class="mt-3 font-serif text-4xl">Âmbar</h3>
                    <p class="mt-3 text-sm leading-6 text-stone-100">Calor, especiarias e texturas que permanecem próximas.</p>
                </div>
            </a>

            <a class="group relative min-h-[31rem] overflow-hidden rounded-[2rem] bg-sand"
               asp-controller="Perfumes"
               asp-action="Index"
               asp-route-familia="Amadeirado">
                <img class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]"
                     src="~/images/showcase/atmosphere-corium.webp"
                     asp-append-version="true"
                     width="900"
                     height="1125"
                     alt="Couro, cedro e pedra em composição de luz lateral"
                     loading="lazy"
                     decoding="async" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent" aria-hidden="true"></div>
                <div class="absolute inset-x-0 bottom-0 p-7 text-white">
                    <p class="text-[0.68rem] font-semibold tracking-[0.22em] uppercase">Corium · Tátil</p>
                    <h3 class="mt-3 font-serif text-4xl">Madeira</h3>
                    <p class="mt-3 text-sm leading-6 text-stone-100">Matéria, sombra e uma elegância de contornos precisos.</p>
                </div>
            </a>

            <a class="group relative min-h-[31rem] overflow-hidden rounded-[2rem] bg-sand"
               asp-controller="Perfumes"
               asp-action="Index"
               asp-route-familia="Cítrico amadeirado">
                <img class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]"
                     src="~/images/showcase/atmosphere-cumiere.webp"
                     asp-append-version="true"
                     width="900"
                     height="1125"
                     alt="Bergamota, folhas verdes e madeira sob luz dourada"
                     loading="lazy"
                     decoding="async" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent" aria-hidden="true"></div>
                <div class="absolute inset-x-0 bottom-0 p-7 text-white">
                    <p class="text-[0.68rem] font-semibold tracking-[0.22em] uppercase">Cumiere · Luminoso</p>
                    <h3 class="mt-3 font-serif text-4xl">Cítrico</h3>
                    <p class="mt-3 text-sm leading-6 text-stone-100">Folhas, cascas e luz para começar o dia em movimento.</p>
                </div>
            </a>
        </div>
    </div>
</section>

<section class="overflow-hidden bg-ink text-white" aria-labelledby="editorial-title">
    <div class="mx-auto grid max-w-7xl gap-14 px-5 py-20 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:px-10 lg:py-28">
        <div class="grid grid-cols-[1.1fr_0.9fr] items-end gap-4">
            <img class="w-full rounded-[2rem] object-cover shadow-2xl shadow-black/30"
                 src="~/images/showcase/brand-manifesto.webp"
                 asp-append-version="true"
                 width="432"
                 height="462"
                 alt="Apresentação Sallvat & Co. com sombras botânicas"
                 loading="lazy"
                 decoding="async" />
            <img class="mb-8 w-full rounded-[2rem] object-cover shadow-2xl shadow-black/30"
                 src="~/images/showcase/brand-presentation.webp"
                 asp-append-version="true"
                 width="399"
                 height="501"
                 alt="Frasco e apresentação de perfume Sallvat & Co."
                 loading="lazy"
                 decoding="async" />
        </div>
        <div>
            <p class="text-xs font-semibold tracking-[0.22em] text-stone-400 uppercase">Direção de marca</p>
            <h2 id="editorial-title" class="mt-5 font-serif text-5xl leading-[0.98] tracking-tight sm:text-6xl">Perfume como gesto de identidade.</h2>
            <p class="mt-7 max-w-xl text-base leading-8 text-stone-300">Cada criação é apresentada pelo que desperta: notas, texturas, momentos e presença. Uma linguagem visual que aproxima a escolha antes mesmo da primeira borrifada.</p>
            <p class="mt-6 max-w-xl text-sm leading-7 text-stone-400">Esta coleção está em curadoria. Nomes, descrições, preços e disponibilidade serão confirmados antes do lançamento comercial.</p>
            <a class="mt-9 inline-flex min-h-12 items-center justify-center rounded-full bg-white px-7 py-3 text-sm font-semibold text-ink transition hover:bg-sand"
               asp-controller="Home"
               asp-action="About">Conhecer a proposta</a>
        </div>
    </div>
</section>

<section class="overflow-hidden bg-paper" aria-labelledby="manifesto-title">
    <div class="mx-auto grid max-w-7xl gap-14 px-5 py-20 sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:px-10 lg:py-28">
        <div>
            <p class="eyebrow">A experiência Sallvat</p>
            <h2 id="manifesto-title" class="mt-5 font-serif text-5xl leading-[0.98] tracking-tight sm:text-6xl">
                Da primeira nota à última impressão.
            </h2>
            <p class="mt-7 max-w-xl text-base leading-8 text-stone-600">
                A fragrância certa não ocupa apenas o espaço: ela revela intenção, acompanha encontros e permanece na lembrança.
            </p>
            <a class="btn-primary mt-9" asp-controller="Perfumes" asp-action="Index">Encontrar meu perfume</a>
        </div>

        <ol class="border-y border-stone-300">
            <li class="grid grid-cols-[3rem_1fr] gap-5 border-b border-stone-300 py-7">
                <span class="font-serif text-2xl text-copper">01</span>
                <div><h3 class="font-serif text-2xl">Descoberta</h3><p class="mt-2 text-sm leading-6 text-stone-600">Famílias e notas ajudam a reconhecer o que desperta a sua curiosidade.</p></div>
            </li>
            <li class="grid grid-cols-[3rem_1fr] gap-5 border-b border-stone-300 py-7">
                <span class="font-serif text-2xl text-copper">02</span>
                <div><h3 class="font-serif text-2xl">Presença</h3><p class="mt-2 text-sm leading-6 text-stone-600">Volume, projeção e ocasião tornam a escolha mais clara e pessoal.</p></div>
            </li>
            <li class="grid grid-cols-[3rem_1fr] gap-5 py-7">
                <span class="font-serif text-2xl text-copper">03</span>
                <div><h3 class="font-serif text-2xl">Memória</h3><p class="mt-2 text-sm leading-6 text-stone-600">Uma assinatura olfativa que continua contando a sua história.</p></div>
            </li>
        </ol>
    </div>
</section>

<section class="relative isolate overflow-hidden bg-ink text-white" aria-labelledby="closing-title">
    <img class="absolute inset-0 -z-20 h-full w-full object-cover object-[70%_center] opacity-45"
         src="~/images/home/hero-coastal.webp"
         asp-append-version="true"
         width="1536"
         height="1024"
         alt=""
         loading="lazy"
         decoding="async" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/90 via-black/70 to-black/30" aria-hidden="true"></div>
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:px-10 lg:py-28">
        <p class="text-xs font-semibold tracking-[0.22em] text-stone-200 uppercase">A nossa coleção começa agora</p>
        <h2 id="closing-title" class="mt-5 max-w-3xl font-serif text-5xl leading-none tracking-tight sm:text-6xl">Descubra qual história você quer contar.</h2>
        <a class="mt-9 inline-flex min-h-12 items-center justify-center rounded-full bg-white px-7 py-3 text-sm font-semibold text-ink transition hover:bg-sand"
           asp-controller="Perfumes"
           asp-action="Index">Explorar perfumes</a>
    </div>
</section>
