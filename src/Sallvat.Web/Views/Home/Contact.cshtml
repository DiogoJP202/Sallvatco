@{
    ViewData["Title"] = "Contato";
    ViewData["Description"] = "Fale com a Sallvat & Co. pelo WhatsApp, Instagram ou e-mail.";
}

<section class="bg-paper">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 lg:px-10 lg:py-24">
        <h1 class="font-serif text-5xl leading-none tracking-tight sm:text-7xl">Fale com a Sallvat &amp; Co.</h1>
        <p class="mt-6 max-w-xl text-base leading-7 text-stone-600">Tire dúvidas sobre fragrâncias, produtos e entrega pelos nossos canais de atendimento.</p>
        <ul class="mt-10 grid gap-4 sm:grid-cols-3">
            <li class="rounded-2xl border border-stone-300 bg-white p-6">
                <h2 class="font-serif text-2xl">WhatsApp</h2>
                <a class="btn-primary mt-4" href="@Sallvat.Web.Seo.ProductStructuredData.WhatsApp">Abrir conversa</a>
                <p class="mt-3 text-sm text-stone-600">@Sallvat.Web.Seo.ProductStructuredData.ContactPhone</p>
            </li>
            <li class="rounded-2xl border border-stone-300 bg-white p-6">
                <h2 class="font-serif text-2xl">Instagram</h2>
                <a class="mt-4 inline-block text-sm font-semibold underline underline-offset-4" href="@Sallvat.Web.Seo.ProductStructuredData.Instagram">@@sallvatco</a>
            </li>
            <li class="rounded-2xl border border-stone-300 bg-white p-6">
                <h2 class="font-serif text-2xl">E-mail</h2>
                <a class="mt-4 inline-block text-sm font-semibold underline underline-offset-4 break-all" href="@("mailto:" + Sallvat.Web.Seo.ProductStructuredData.ContactEmail)">@Sallvat.Web.Seo.ProductStructuredData.ContactEmail</a>
            </li>
        </ul>
    </div>
</section>
