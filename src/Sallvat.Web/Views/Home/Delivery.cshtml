@{
    ViewData["Title"] = "Entrega";
    ViewData["Description"] = "Informações sobre preparação, postagem e prazo de entrega dos pedidos Sallvat & Co.";
}

<section class="bg-paper">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 lg:px-10 lg:py-24">
        <h1 class="font-serif text-5xl leading-none tracking-tight sm:text-7xl">Entrega</h1>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <section class="rounded-2xl border border-stone-300 bg-white p-6">
                <h2 class="font-serif text-2xl">Preparação e postagem</h2>
                <p class="mt-3 text-sm leading-7 text-stone-600">O prazo médio para preparar e postar um pedido é de <strong>dois dias úteis</strong>.</p>
            </section>
            <section class="rounded-2xl border border-stone-300 bg-white p-6">
                <h2 class="font-serif text-2xl">Prazo de transporte</h2>
                <p class="mt-3 text-sm leading-7 text-stone-600">O transporte começa após a postagem. O valor e o prazo do frete variam conforme o CEP, a embalagem e o serviço disponível.</p>
            </section>
        </div>
        <a class="btn-secondary mt-8" asp-action="Contact">Tirar dúvidas sobre entrega</a>
    </div>
</section>
