@model BodySplashCollectionPageViewModel
@{
    ViewData["Title"] = "Linha corporal";
    ViewData["Description"] = "Conheça a linha de body splashes de 200 ml da Sallvat & Co.";
}

<section class="overflow-hidden border-b border-stone-300/70 bg-[#eee6da]" aria-labelledby="body-splashes-title">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:px-10">
        <div class="max-w-2xl">
            <p class="eyebrow">Linha corporal · 200 ml</p>
            <h1 id="body-splashes-title" class="mt-6 font-serif text-5xl leading-[0.96] tracking-[-0.035em] sm:text-7xl">O cuidado encontra a sua fragrância.</h1>
            <p class="mt-8 max-w-xl text-lg leading-8 text-stone-700">Uma seleção de body splashes para descobrir de perto. Frascos, cores e universos que fazem parte da coleção Sallvat &amp; Co.</p>
            <a class="btn-primary mt-8" href="#body-splashes-grid-title">Explorar a linha corporal</a>
        </div>
        <figure class="mx-auto w-full max-w-md">
            <div class="overflow-hidden rounded-[2.5rem] bg-[#f2ece3] shadow-xl shadow-stone-900/10">
                <img class="aspect-[4/5] w-full object-contain"
                     src="~/images/showcase/packshots/body-sea-salt.webp"
                     srcset="@Url.Content("~/images/showcase/packshots/body-sea-salt-thumb.webp") 480w, @Url.Content("~/images/showcase/packshots/body-sea-salt.webp") 1120w"
                     sizes="(min-width: 512px) 448px, calc(100vw - 40px)"
                     asp-append-version="true"
                     width="1120"
                     height="1400"
                     alt="Frasco de body splash Sea Salt sobre fundo claro"
                     decoding="async"
                     fetchpriority="high" />
            </div>
            <figcaption class="mt-4 flex items-center justify-between gap-4 px-2 text-xs text-stone-600"><span>Sea Salt · Body splash</span><span>200 ml</span></figcaption>
        </figure>
    </div>
</section>

<section class="bg-paper" aria-labelledby="body-splashes-grid-title">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:px-10 lg:py-28">
        <div class="grid items-end gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
            <div>
                <p class="eyebrow">Seleção apresentada</p>
                <h2 id="body-splashes-grid-title" class="mt-5 max-w-3xl font-serif text-5xl leading-none tracking-tight sm:text-6xl">Nove maneiras de prolongar a presença.</h2>
            </div>
            <p class="text-sm leading-7 text-stone-600 lg:text-right">Explore os nomes, as cores e as propostas da linha. Os detalhes de cada produto serão confirmados antes do lançamento comercial.</p>
        </div>

        <div class="mt-12 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var product in Model.Products)
            {
                <partial name="_BodySplashCard" model="product" />
            }
        </div>
    </div>
</section>

<section class="bg-[#ddd2c4]">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-5 py-16 sm:px-8 md:flex-row md:items-center lg:px-10">
        <div>
            <p class="eyebrow">Perfumes Sallvat &amp; Co.</p>
            <h2 class="mt-4 font-serif text-4xl leading-none">Continue pela coleção de fragrâncias.</h2>
        </div>
        <a class="btn-primary" asp-controller="Perfumes" asp-action="Index">Explorar perfumes</a>
    </div>
</section>
