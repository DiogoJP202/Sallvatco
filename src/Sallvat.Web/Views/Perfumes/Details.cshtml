@model ProductDetailsPageViewModel
@{
    var product = Model.Product;
    var cover = product.Images.First(image => image.IsCover);
    ViewData["Title"] = product.Name;
    ViewData["Description"] = product.ShortDescription;
    ViewData["StructuredData"] = Model.StructuredData;
}

<section class="border-b border-stone-300/70 bg-[#eee6da]">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 py-10 sm:px-8 lg:grid-cols-[1.08fr_0.92fr] lg:items-start lg:px-10 lg:py-20">
        <div class="lg:sticky lg:top-28">
            <div class="relative overflow-hidden rounded-[2.5rem] bg-sand shadow-2xl shadow-stone-900/10">
                <img class="aspect-[4/5] w-full object-contain"
                     src="@cover.LargeUrl"
                     srcset="@cover.ThumbnailUrl 480w, @cover.LargeUrl 1600w"
                     sizes="(min-width: 1024px) 54vw, 100vw"
                     width="@cover.Width"
                     height="@cover.Height"
                     alt="@cover.AltText"
                     decoding="async"
                     fetchpriority="high"
                     data-gallery-main />
                <span class="absolute top-6 left-6 rounded-full bg-paper/90 px-4 py-2 text-[0.65rem] font-semibold tracking-[0.18em] text-ink uppercase backdrop-blur-sm">Perfume artesanal</span>
            </div>
            @if (product.Images.Count > 1)
            {
                <div class="mt-4 grid grid-cols-4 gap-3" aria-label="Galeria de imagens">
                    @foreach (var image in product.Images)
                    {
                        <button type="button"
                                aria-label="Exibir: @image.AltText"
                                aria-pressed="@(image.IsCover ? "true" : "false")"
                                data-gallery-thumbnail
                                data-large-url="@image.LargeUrl"
                                data-thumbnail-url="@image.ThumbnailUrl"
                                data-alt="@image.AltText">
                            <img class="aspect-[4/5] w-full object-cover" src="@image.ThumbnailUrl" width="@image.Width" height="@image.Height" alt="" loading="lazy" decoding="async" />
                        </button>
                    }
                </div>
            }
        </div>

        <div class="py-2 lg:py-8">
            <a class="inline-flex items-center gap-2 text-sm font-semibold text-copper transition hover:text-ink" asp-action="Index"><span aria-hidden="true">←</span> Voltar aos perfumes</a>
            <p class="eyebrow mt-10">@product.OlfactoryFamily · @product.Concentration</p>
            <h1 class="mt-5 font-serif text-5xl leading-none tracking-[-0.035em] sm:text-7xl">@product.Name</h1>
            <p class="mt-7 text-lg leading-8 text-stone-600">@product.ShortDescription</p>

            <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-stone-300 ring-1 ring-stone-300">
                <div class="bg-paper px-5 py-4"><dt class="text-[0.62rem] font-semibold tracking-[0.16em] text-stone-500 uppercase">Projeção</dt><dd class="mt-1 font-serif text-lg">@product.Projection</dd></div>
                <div class="bg-paper px-5 py-4"><dt class="text-[0.62rem] font-semibold tracking-[0.16em] text-stone-500 uppercase">Fixação</dt><dd class="mt-1 font-serif text-lg">@product.Longevity</dd></div>
            </dl>

            <div class="mt-9" aria-labelledby="volume-title">
                <div class="flex items-center justify-between gap-4">
                    <h2 id="volume-title" class="text-sm font-semibold">Escolha o volume</h2>
                    <span class="text-[0.62rem] font-semibold tracking-[0.16em] text-stone-500 uppercase">Preço por variante</span>
                </div>
                <div class="mt-3 grid gap-3 sm:grid-cols-2">
                    @foreach (var variant in product.Variants)
                    {
                        var isSelected = variant.Id == Model.SelectedVariant.Id;
                        <a class="variant-option"
                           asp-action="Details"
                           asp-route-slug="@product.Slug"
                           asp-route-variante="@variant.Id"
                           aria-current="@(isSelected ? "true" : null)"
                           data-variant-option
                           data-volume="@variant.VolumeMl"
                           data-price="@variant.Price.ToString("C")"
                           data-available="@variant.Available">
                            <span class="flex items-center justify-between gap-4"><strong>@variant.VolumeMl ml</strong><span>@variant.Price.ToString("C")</span></span>
                            <small class="mt-1 block">@(variant.Available > 0 ? $"{variant.Available} {(variant.Available == 1 ? "unidade disponível" : "unidades disponíveis")}" : "Esgotado")</small>
                        </a>
                    }
                </div>
            </div>

            <div class="mt-6 rounded-2xl border border-stone-300 bg-white p-6 shadow-sm" aria-live="polite">
                <div class="flex items-end justify-between gap-4">
                    <span class="text-sm text-stone-600">Selecionado: <span data-selected-volume>@Model.SelectedVariant.VolumeMl ml</span></span>
                    <strong class="font-serif text-3xl" data-selected-price>@Model.SelectedVariant.Price.ToString("C")</strong>
                </div>
                <p class="mt-3 border-t border-stone-200 pt-4 text-xs leading-5 text-stone-500" data-selected-availability>@(Model.SelectedVariant.Available > 0 ? $"{Model.SelectedVariant.Available} {(Model.SelectedVariant.Available == 1 ? "unidade disponível" : "unidades disponíveis")}. Valores e estoque ilustrativos." : "Esta variante está temporariamente esgotada.")</p>
                <button class="btn-primary mt-5 w-full"
                        type="button"
                        disabled="@(Model.SelectedVariant.Available == 0)"
                        data-demo-purchase>
                    @(Model.SelectedVariant.Available > 0 ? "Adicionar à sacola · demonstração" : "Variante esgotada")
                </button>
            </div>
        </div>
    </div>
</section>

<dialog class="w-[calc(100%-2rem)] max-w-xl rounded-[2rem] bg-paper p-0 text-ink shadow-2xl"
        aria-labelledby="purchase-dialog-title"
        data-purchase-dialog>
    <div class="p-7 sm:p-10">
        <p class="eyebrow">Demonstração visual</p>
        <h2 id="purchase-dialog-title" class="mt-4 font-serif text-4xl leading-tight">A experiência de compra está a caminho.</h2>
        <p class="mt-5 text-sm leading-7 text-stone-600">Carrinho, checkout e pagamento ainda não estão habilitados nesta apresentação. Você pode continuar conhecendo as fragrâncias com segurança.</p>
        <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
            <button class="btn-secondary" type="button" data-dialog-close>Fechar</button>
            <a class="btn-primary" asp-action="Index">Continuar explorando</a>
        </div>
    </div>
</dialog>

<section class="bg-white" aria-labelledby="notes-title">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:px-10 lg:py-28">
        <div class="grid gap-14 lg:grid-cols-[0.85fr_1.15fr]">
            <div>
                <p class="eyebrow">Pirâmide olfativa</p>
                <h2 id="notes-title" class="mt-5 font-serif text-4xl leading-tight sm:text-5xl">Uma evolução revelada em camadas.</h2>
            </div>
            <dl class="grid gap-px overflow-hidden rounded-[2rem] bg-stone-300 ring-1 ring-stone-300 sm:grid-cols-3">
                <div class="bg-paper p-7"><dt><span class="block font-serif text-2xl text-copper">01</span><strong class="mt-5 block text-sm">Saída</strong></dt><dd class="mt-2 text-sm leading-6 text-stone-600">@product.TopNotes</dd></div>
                <div class="bg-paper p-7"><dt><span class="block font-serif text-2xl text-copper">02</span><strong class="mt-5 block text-sm">Coração</strong></dt><dd class="mt-2 text-sm leading-6 text-stone-600">@product.HeartNotes</dd></div>
                <div class="bg-paper p-7"><dt><span class="block font-serif text-2xl text-copper">03</span><strong class="mt-5 block text-sm">Fundo</strong></dt><dd class="mt-2 text-sm leading-6 text-stone-600">@product.BaseNotes</dd></div>
            </dl>
        </div>
    </div>
</section>

<section class="bg-ink text-stone-100" aria-labelledby="fragrance-title">
    <div class="mx-auto grid max-w-7xl gap-14 px-5 py-20 sm:px-8 lg:grid-cols-[1.1fr_0.9fr] lg:px-10 lg:py-28">
        <div>
            <p class="text-xs font-semibold tracking-[0.2em] text-stone-400 uppercase">A fragrância</p>
            <h2 id="fragrance-title" class="mt-5 font-serif text-4xl text-white sm:text-5xl">A história por trás da presença.</h2>
            <p class="mt-7 max-w-2xl whitespace-pre-line text-base leading-8 text-stone-300">@product.Description</p>
        </div>
        <dl class="grid content-start gap-px overflow-hidden rounded-[2rem] bg-white/15 sm:grid-cols-2">
            <div class="bg-white/5 p-6"><dt class="text-[0.62rem] font-semibold tracking-[0.16em] text-stone-400 uppercase">Família</dt><dd class="mt-2 font-serif text-xl text-white">@product.OlfactoryFamily</dd></div>
            <div class="bg-white/5 p-6"><dt class="text-[0.62rem] font-semibold tracking-[0.16em] text-stone-400 uppercase">Concentração</dt><dd class="mt-2 font-serif text-xl text-white">@product.Concentration</dd></div>
            <div class="bg-white/5 p-6"><dt class="text-[0.62rem] font-semibold tracking-[0.16em] text-stone-400 uppercase">Ocasiões</dt><dd class="mt-2 font-serif text-xl text-white">@product.Occasions</dd></div>
            <div class="bg-white/5 p-6"><dt class="text-[0.62rem] font-semibold tracking-[0.16em] text-stone-400 uppercase">Momento</dt><dd class="mt-2 font-serif text-xl text-white">@product.Season · @product.Period</dd></div>
        </dl>
    </div>
</section>
