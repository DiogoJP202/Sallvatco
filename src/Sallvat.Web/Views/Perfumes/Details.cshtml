@model ProductDetailsPageViewModel
@{
    var product = Model.Product;
    ViewData["Title"] = product.Name;
    ViewData["Description"] = product.ShortDescription;
    ViewData["StructuredData"] = Model.StructuredData;
}

<section class="mx-auto grid max-w-7xl gap-12 px-5 py-12 sm:px-8 lg:grid-cols-2 lg:px-10 lg:py-20">
    <div>
        @{ var cover = product.Images.First(image => image.IsCover); }
        <img class="aspect-[4/5] w-full rounded-[2rem] bg-sand object-cover"
             src="@cover.LargeUrl"
             srcset="@cover.ThumbnailUrl 480w, @cover.LargeUrl 1600w"
             sizes="(min-width: 1024px) 50vw, 100vw"
             width="@cover.Width"
             height="@cover.Height"
             alt="@cover.AltText"
             decoding="async"
             fetchpriority="high" />
        @if (product.Images.Count > 1)
        {
            <div class="mt-4 grid grid-cols-4 gap-3" aria-label="Galeria de imagens">
                @foreach (var image in product.Images)
                {
                    <img class="aspect-[4/5] w-full rounded-xl bg-sand object-cover" src="@image.ThumbnailUrl" width="@image.Width" height="@image.Height" alt="@image.AltText" loading="lazy" decoding="async" />
                }
            </div>
        }
    </div>
    <div class="self-center">
        <a class="text-sm font-semibold text-copper" asp-action="Index">← Voltar aos perfumes</a>
        <p class="eyebrow mt-9">@product.OlfactoryFamily · @product.Concentration</p>
        <h1 class="mt-4 font-serif text-5xl tracking-tight sm:text-6xl">@product.Name</h1>
        <p class="mt-6 text-lg leading-8 text-stone-600">@product.ShortDescription</p>

        <div class="mt-8" aria-labelledby="volume-title">
            <h2 id="volume-title" class="text-sm font-semibold">Escolha o volume</h2>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
            @foreach (var variant in product.Variants)
            {
                var isSelected = variant.Id == Model.SelectedVariant.Id;
                <a class="rounded-2xl border px-5 py-4 transition @(isSelected ? "border-ink bg-ink text-white" : "border-stone-300 bg-white hover:border-copper")"
                   asp-action="Details"
                   asp-route-slug="@product.Slug"
                   asp-route-variante="@variant.Id"
                   aria-current="@(isSelected ? "true" : null)">
                    <span class="flex items-center justify-between gap-4"><strong>@variant.VolumeMl ml</strong><span>@variant.Price.ToString("C")</span></span>
                    <small class="mt-1 block @(isSelected ? "text-stone-300" : "text-stone-500")">@(variant.Available > 0 ? $"{variant.Available} disponível(is)" : "Esgotado")</small>
                </a>
            }
            </div>
        </div>
        <div class="mt-6 rounded-2xl border border-stone-300 bg-white p-5" aria-live="polite">
            <div class="flex items-center justify-between gap-4"><span class="text-sm text-stone-600">Selecionado: @Model.SelectedVariant.VolumeMl ml</span><strong class="text-xl">@Model.SelectedVariant.Price.ToString("C")</strong></div>
            <p class="mt-2 text-xs leading-5 text-stone-500">@(Model.SelectedVariant.Available > 0 ? "Disponível. A compra será habilitada na etapa de carrinho." : "Esta variante está temporariamente esgotada.")</p>
        </div>
    </div>
</section>

<section class="border-y border-stone-300/70 bg-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 py-14 sm:px-8 lg:grid-cols-[1fr_1.2fr] lg:px-10">
        <div>
            <p class="eyebrow">Pirâmide olfativa</p>
            <dl class="mt-6 space-y-5 text-sm">
                <div><dt class="font-semibold">Saída</dt><dd class="mt-1 text-stone-600">@product.TopNotes</dd></div>
                <div><dt class="font-semibold">Coração</dt><dd class="mt-1 text-stone-600">@product.HeartNotes</dd></div>
                <div><dt class="font-semibold">Fundo</dt><dd class="mt-1 text-stone-600">@product.BaseNotes</dd></div>
            </dl>
        </div>
        <div>
            <p class="eyebrow">A fragrância</p>
            <p class="mt-6 whitespace-pre-line text-base leading-8 text-stone-700">@product.Description</p>
            <dl class="mt-8 grid gap-5 sm:grid-cols-2">
                <div><dt class="text-xs font-semibold tracking-wide text-stone-500 uppercase">Projeção</dt><dd class="mt-1">@product.Projection</dd></div>
                <div><dt class="text-xs font-semibold tracking-wide text-stone-500 uppercase">Fixação</dt><dd class="mt-1">@product.Longevity</dd></div>
                <div><dt class="text-xs font-semibold tracking-wide text-stone-500 uppercase">Ocasiões</dt><dd class="mt-1">@product.Occasions</dd></div>
                <div><dt class="text-xs font-semibold tracking-wide text-stone-500 uppercase">Momento</dt><dd class="mt-1">@product.Season · @product.Period</dd></div>
            </dl>
        </div>
    </div>
</section>
