@model CatalogPage
@{
    ViewData["Title"] = "Perfumes";
    ViewData["Description"] = "Conheça os perfumes publicados pela curadoria Sallvat & Co.";
}

<section class="relative isolate min-h-[28rem] overflow-hidden border-b border-stone-300/70 bg-[#ddd2c4]">
    <img class="absolute inset-y-0 right-0 -z-20 h-full w-full object-cover object-[58%_center] sm:w-[68%] lg:w-[58%]"
         src="~/images/home/collection-fresh.webp"
         asp-append-version="true"
         width="1152"
         height="1440"
         alt=""
         decoding="async" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[#ddd2c4] via-[#ddd2c4]/95 to-[#ddd2c4]/25 sm:via-[#ddd2c4]/80" aria-hidden="true"></div>
    <div class="mx-auto flex min-h-[28rem] max-w-7xl items-center px-5 py-16 sm:px-8 lg:px-10">
        <div class="max-w-2xl">
            <p class="eyebrow">A coleção</p>
            <h1 class="mt-5 font-serif text-6xl leading-none tracking-tight sm:text-7xl">Perfumes</h1>
            <p class="mt-6 max-w-xl text-base leading-7 text-stone-700">
                Fragrâncias apresentadas com notas, concentração e opções de volume para uma escolha cuidadosa e pessoal.
            </p>
            @if (Model.TotalItems > 0)
            {
                <p class="mt-8 text-[0.68rem] font-semibold tracking-[0.2em] text-stone-600 uppercase">@Model.TotalItems @(Model.TotalItems == 1 ? "fragrância publicada" : "fragrâncias publicadas")</p>
            }
        </div>
    </div>
</section>

<section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:px-10 lg:py-20">
    @if (Model.Families.Count > 0)
    {
        <nav class="mb-12 flex flex-wrap gap-2" aria-label="Filtrar por família olfativa">
            <a class="rounded-full border px-5 py-2.5 text-sm font-semibold transition @(Model.SelectedFamily is null ? "border-ink bg-ink text-white" : "border-stone-300 bg-white hover:border-copper hover:text-copper")"
               asp-action="Index">Todas</a>
            @foreach (var family in Model.Families)
            {
                <a class="rounded-full border px-5 py-2.5 text-sm font-semibold transition @(family == Model.SelectedFamily ? "border-ink bg-ink text-white" : "border-stone-300 bg-white hover:border-copper hover:text-copper")"
                   asp-action="Index"
                   asp-route-familia="@family">@family</a>
            }
        </nav>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="rounded-3xl border border-stone-300 bg-white px-6 py-16 text-center">
            <p class="eyebrow">Em curadoria</p>
            <h2 class="mt-4 font-serif text-3xl">Novas fragrâncias chegarão em breve.</h2>
            <p class="mx-auto mt-4 max-w-xl text-sm leading-6 text-stone-600">
                Nenhum perfume publicado corresponde a esta seleção. O catálogo só exibe itens revisados e prontos para venda.
            </p>
        </div>
    }
    else
    {
        <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var product in Model.Items)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-12 flex justify-center gap-3" aria-label="Paginação">
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <a class="flex h-11 w-11 items-center justify-center rounded-full border text-sm font-semibold @(pageNumber == Model.Page ? "border-ink bg-ink text-white" : "border-stone-300 bg-white")"
                       asp-action="Index"
                       asp-route-familia="@Model.SelectedFamily"
                       asp-route-pagina="@pageNumber">@pageNumber</a>
                }
            </nav>
        }
    }
</section>
