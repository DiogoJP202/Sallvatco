@model CheckoutReviewViewModel
@{
    ViewData["Title"] = "Revisar checkout";
    ViewData["ForceNoIndex"] = true;
    ViewData["Description"] = "Revise os dados normalizados antes da criação do pedido.";
}

<section class="border-b border-stone-300/70 bg-[#e8ded0]">
    <div class="mx-auto max-w-5xl px-5 py-12 sm:px-8 lg:px-10 lg:py-16">
        <p class="eyebrow">Dados validados pelo servidor</p>
        <h1 class="mt-5 font-serif text-5xl leading-none tracking-tight sm:text-7xl">Revise antes de continuar.</h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-stone-600">Ainda não criamos um pedido, reservamos estoque ou iniciamos cobrança. Quando a integração está configurada, as opções abaixo vêm do Melhor Envio para este CEP e para os volumes atuais.</p>
    </div>
</section>

<section class="bg-paper">
    <div class="mx-auto grid max-w-5xl gap-6 px-5 py-12 sm:px-8 lg:grid-cols-2 lg:px-10 lg:py-16">
        <article class="rounded-[2rem] border border-stone-300 bg-white p-7 shadow-sm">
            <p class="eyebrow">Comprador</p>
            <h2 class="mt-4 font-serif text-3xl">@Model.Draft.Buyer.Name</h2>
            <dl class="mt-5 grid gap-3 text-sm text-stone-600">
                <div><dt class="sr-only">E-mail</dt><dd>@Model.Draft.Buyer.Email</dd></div>
                <div><dt class="sr-only">Telefone</dt><dd>@Model.Draft.Buyer.Phone</dd></div>
            </dl>
        </article>
        <article class="rounded-[2rem] border border-stone-300 bg-white p-7 shadow-sm">
            <p class="eyebrow">Entrega</p>
            <h2 class="mt-4 font-serif text-3xl">@Model.Draft.Delivery.RecipientName</h2>
            <address class="mt-5 text-sm leading-7 text-stone-600 not-italic">
                @Model.Draft.Delivery.Street, @Model.Draft.Delivery.Number<br />
                @if (!string.IsNullOrEmpty(Model.Draft.Delivery.Complement))
                {
                    @Model.Draft.Delivery.Complement<br />
                }
                @Model.Draft.Delivery.District · @Model.Draft.Delivery.City/@Model.Draft.Delivery.StateCode<br />
                CEP @Model.Draft.Delivery.PostalCode · @Model.Draft.Delivery.CountryCode
            </address>
        </article>
        <section class="rounded-[2rem] border border-stone-300 bg-white p-7 shadow-sm lg:col-span-2" aria-labelledby="freight-title">
            <h2 class="font-serif text-3xl">Sua seleção</h2>
            <ul class="mt-5 grid gap-3 text-sm">
                @foreach (var item in Model.Cart.Items)
                {
                    <li class="flex flex-wrap justify-between gap-2 border-b border-stone-200 pb-3">
                        <span>@item.Quantity × @item.ProductName · @item.VolumeMl ml</span>
                        <span>@item.UnitPrice.ToString("C") por unidade · @item.LineTotal.ToString("C")</span>
                    </li>
                }
            </ul>
            @if (Model.Cart.Coupon is { } coupon)
            {
                <p class="mt-4 text-sm">Cupom @coupon.Code: desconto de @Model.Cart.DiscountTotal.ToString("C").</p>
            }
            <p class="mt-4 mb-8 text-sm font-semibold">Subtotal após descontos: @Model.Cart.Total.ToString("C")</p>
            <p class="eyebrow">Cotação de entrega</p>
            <h2 id="freight-title" class="mt-4 font-serif text-3xl">Opções para o seu pedido</h2>
            @if (Model.Freight.PreparationBusinessDays > 0)
            {
                <p class="mt-4 text-sm leading-6 text-stone-600" data-preparation-days="@Model.Freight.PreparationBusinessDays">Preparação e postagem: em média @Model.Freight.PreparationBusinessDays dias úteis. Esse período é separado do prazo de transporte informado abaixo.</p>
            }
            @if (Model.Freight.Succeeded)
            {
                <div class="mt-6 grid gap-4 sm:grid-cols-2">
                    @foreach (var option in Model.Freight.Options)
                    {
                        <article class="rounded-2xl border border-stone-300 bg-paper p-5">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <p class="text-xs font-semibold tracking-[0.14em] text-stone-500 uppercase">@option.Carrier</p>
                                    <h3 class="mt-2 text-lg font-semibold text-ink">@option.Service</h3>
                                </div>
                                <strong class="font-serif text-2xl">@option.Price.ToString("C")</strong>
                            </div>
                            <p class="mt-4 text-sm text-stone-600">De @option.MinimumBusinessDays a @option.MaximumBusinessDays dias úteis após a postagem.</p>
                            <p class="mt-2 text-xs text-stone-500">Total com entrega: @((Model.Cart.Total + option.Price).ToString("C"))</p>
                            @if (Model.Confirmations.TryGetValue(option.QuoteId, out var reviewToken))
                            {
                                <form asp-action="Confirm" method="post" class="mt-5 grid gap-4">
                                    <input type="hidden" name="reviewToken" value="@reviewToken" />
                                    <label class="flex items-start gap-3 text-sm leading-6">
                                        <input type="checkbox" name="confirmed" value="true" required class="mt-1 size-5 shrink-0" />
                                        Confirmo os dados, o total e este frete para criar um pedido de teste e reservar estoque. Não é uma compra real.
                                    </label>
                                    <button class="btn-primary" type="submit">Confirmar pedido de teste</button>
                                </form>
                            }
                        </article>
                    }
                </div>
                <p class="mt-5 text-xs leading-5 text-stone-500">Preço e prazo serão consultados novamente antes da criação do pedido. Mudanças exigirão uma nova confirmação.</p>
            }
            else
            {
                <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm leading-6 text-amber-950" role="status">
                    @foreach (var error in Model.Freight.Errors)
                    {
                        <p>@error</p>
                    }
                </div>
            }
        </section>
        <div class="rounded-[2rem] bg-ink p-7 text-white shadow-xl lg:col-span-2">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="text-[0.62rem] font-semibold tracking-[0.18em] text-stone-400 uppercase">Total parcial revalidado</p>
                    <p class="mt-3 font-serif text-4xl">@Model.Cart.Total.ToString("C")</p>
                    <p class="mt-3 max-w-xl text-xs leading-5 text-stone-300">Fluxo exclusivo de homologação. Compras reais permanecem desativadas. Quando habilitado, confirme uma opção de frete acima; o pagamento de teste será iniciado somente na próxima tela.</p>
                </div>
                @if (Model.Confirmations.Count == 0)
                {
                    <button class="min-h-12 cursor-not-allowed rounded-full bg-stone-600 px-7 py-3 text-sm font-semibold text-stone-300" type="button" disabled>Aguardando homologação do frete</button>
                }
            </div>
            <a class="mt-6 inline-block text-sm font-semibold text-stone-300 underline underline-offset-4 hover:text-white" asp-action="Index">Corrigir os dados</a>
        </div>
    </div>
</section>
