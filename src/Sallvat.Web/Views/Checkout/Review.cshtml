@model CheckoutReviewViewModel
@{
    ViewData["Title"] = "Revisar checkout";
    ViewData["Description"] = "Revise os dados normalizados antes da criação do pedido.";
}

<section class="border-b border-stone-300/70 bg-[#e8ded0]">
    <div class="mx-auto max-w-5xl px-5 py-12 sm:px-8 lg:px-10 lg:py-16">
        <p class="eyebrow">Dados validados pelo servidor</p>
        <h1 class="mt-5 font-serif text-5xl leading-none tracking-tight sm:text-7xl">Revise antes de continuar.</h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-stone-600">Ainda não criamos um pedido, reservamos estoque, calculamos frete ou iniciamos cobrança.</p>
    </div>
</section>

<section class="bg-paper">
    <div class="mx-auto grid max-w-5xl gap-6 px-5 py-12 sm:px-8 lg:grid-cols-2 lg:px-10 lg:py-16">
        <article class="rounded-[2rem] border border-stone-300 bg-white p-7 shadow-sm">
            <p class="eyebrow">Comprador</p>
            <h2 class="mt-4 font-serif text-3xl">@Model.Draft.Buyer.Name</h2>
            <dl class="mt-5 grid gap-3 text-sm text-stone-600">
                <div><dt class="sr-only">E-mail</dt><dd>@Model.Draft.Buyer.Email</dd></div>
                <div><dt class="sr-only">Telefone</dt><dd>@Model.Draft.Buyer.Phone</dd></div>
            </dl>
        </article>
        <article class="rounded-[2rem] border border-stone-300 bg-white p-7 shadow-sm">
            <p class="eyebrow">Entrega</p>
            <h2 class="mt-4 font-serif text-3xl">@Model.Draft.Delivery.RecipientName</h2>
            <address class="mt-5 text-sm leading-7 text-stone-600 not-italic">
                @Model.Draft.Delivery.Street, @Model.Draft.Delivery.Number<br />
                @if (!string.IsNullOrEmpty(Model.Draft.Delivery.Complement))
                {
                    @Model.Draft.Delivery.Complement<br />
                }
                @Model.Draft.Delivery.District · @Model.Draft.Delivery.City/@Model.Draft.Delivery.StateCode<br />
                CEP @Model.Draft.Delivery.PostalCode · @Model.Draft.Delivery.CountryCode
            </address>
        </article>
        <div class="rounded-[2rem] bg-ink p-7 text-white shadow-xl lg:col-span-2">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="text-[0.62rem] font-semibold tracking-[0.18em] text-stone-400 uppercase">Total parcial revalidado</p>
                    <p class="mt-3 font-serif text-4xl">@Model.Cart.Total.ToString("C")</p>
                    <p class="mt-3 max-w-xl text-xs leading-5 text-stone-400">A próxima história implementará criação idempotente do pedido e reserva atômica de estoque. O botão permanece indisponível até essa garantia existir.</p>
                </div>
                <button class="min-h-12 cursor-not-allowed rounded-full bg-stone-600 px-7 py-3 text-sm font-semibold text-stone-300" type="button" disabled>Criar pedido na próxima etapa</button>
            </div>
            <a class="mt-6 inline-block text-sm font-semibold text-stone-300 underline underline-offset-4 hover:text-white" asp-action="Index">Corrigir os dados</a>
        </div>
    </div>
</section>
