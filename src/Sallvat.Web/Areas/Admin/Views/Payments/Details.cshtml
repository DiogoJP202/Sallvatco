@using Sallvat.Application.Payments
@using Sallvat.Web.Models.Payments
@model AdminPaymentDetails
@{
    ViewData["Title"] = "Detalhe do pagamento";
    ViewData["ForceNoIndex"] = true;
    var payment = Model.Payment;
    string Date(DateTimeOffset? value) => value?.ToString("dd/MM/yyyy HH:mm:ss 'UTC'") ?? "Não registrado";
}
<section class="mx-auto max-w-6xl px-6 py-12 lg:px-8">
    <a class="text-sm underline" asp-action="Index">Voltar aos pagamentos</a>
    <h1 class="mt-4 text-3xl font-semibold">Tentativa @payment.Id</h1>
    <p class="mt-3 break-words text-lg">@payment.OrderNumber</p>
    <p class="mt-4 max-w-3xl text-sm leading-6 text-stone-600">Esta página exibe registros locais. A ausência de recibos ou de ID externo não prova ausência de cobrança; não recrie a tentativa nem libere estoque a partir desta tela.</p>
    @if (payment.RecoveryFollowUp != AdminRecoveryFollowUp.None)
    {
        <section class="mt-6 rounded-xl border border-stone-300 bg-white p-4 text-sm" aria-labelledby="follow-up-title">
            <h2 id="follow-up-title" class="font-semibold">Conferência manual necessária</h2>
            <p class="mt-2">@PaymentLabels.RecoveryFollowUp(payment.RecoveryFollowUp)</p>
            <p class="mt-2">Confira estado do pedido, IDs, recibos e execuções abaixo. Se a recuperação estiver habilitada e elegível, uma nova consulta manual exige motivo e confirmação. Caso contrário, mantenha a pendência para tratamento autorizado. Não recrie cobrança nem interprete o limite como recusa de pagamento.</p>
            <a class="mt-3 inline-block underline" asp-action="Index" asp-route-filter="RecoveryFollowUp">Voltar às pendências de recuperação</a>
        </section>
    }
    @if (TempData["RecoveryMessage"] is string message)
    {
        <p class="mt-6 rounded-xl border border-stone-300 bg-white p-4 text-sm" role="status">@message</p>
    }
    <dl class="mt-8 grid gap-5 rounded-3xl border border-stone-200 bg-white p-6 sm:grid-cols-2">
        <div><dt class="text-sm text-stone-600">Ambiente</dt><dd class="mt-1 font-semibold">@(payment.Environment == Sallvat.Domain.Payments.PaymentEnvironment.Sandbox ? "Sandbox (teste)" : "Produção")</dd></div>
        <div><dt class="text-sm text-stone-600">Valor esperado</dt><dd class="mt-1 font-semibold">@payment.Amount.ToString("C") @payment.Currency</dd></div>
        <div><dt class="text-sm text-stone-600">Pagamento</dt><dd class="mt-1 font-semibold">@PaymentLabels.Status(payment.Status)</dd></div>
        <div><dt class="text-sm text-stone-600">Pedido</dt><dd class="mt-1 font-semibold">@PaymentLabels.Order(payment.OrderStatus)</dd></div>
        <div><dt class="text-sm text-stone-600">Envio ao provedor</dt><dd class="mt-1">@PaymentLabels.Dispatch(payment.DispatchState)</dd></div>
        <div><dt class="text-sm text-stone-600">Revisão</dt><dd class="mt-1">@PaymentLabels.Reason(payment.AttentionReason)</dd></div>
        <div class="min-w-0"><dt class="text-sm text-stone-600">ID Orders externo</dt><dd class="mt-1 break-all">@(Model.ExternalOrderId ?? "Não registrado — não reenviar automaticamente")</dd></div>
        <div class="min-w-0"><dt class="text-sm text-stone-600">ID da captura confirmada localmente</dt><dd class="mt-1 break-all">@(Model.ExternalPaymentId ?? "Não registrado")</dd></div>
        <div><dt class="text-sm text-stone-600">Criação</dt><dd class="mt-1">@Date(payment.CreatedAtUtc)</dd></div>
        <div><dt class="text-sm text-stone-600">Atualização local</dt><dd class="mt-1">@Date(payment.UpdatedAtUtc)</dd></div>
        <div><dt class="text-sm text-stone-600">Início do envio</dt><dd class="mt-1">@Date(Model.DispatchStartedAtUtc)</dd></div>
        <div><dt class="text-sm text-stone-600">Limite para pagamento local</dt><dd class="mt-1">@Date(Model.ExpiresAtUtc)</dd></div>
        <div><dt class="text-sm text-stone-600">Confirmação local</dt><dd class="mt-1">@Date(Model.ConfirmedAtUtc)</dd></div>
        <div><dt class="text-sm text-stone-600">Atualização do provedor na captura</dt><dd class="mt-1">@Date(Model.ProviderUpdatedAtUtc)</dd></div>
    </dl>
    <section class="mt-8 rounded-3xl border border-stone-200 bg-white p-6" aria-labelledby="recovery-title">
        <h2 id="recovery-title" class="text-xl font-semibold">Recuperar confirmação</h2>
        @if (Model.CanRecover)
        {
            <p id="recovery-help" class="mt-3 text-sm leading-6 text-stone-600">Consulta o ID já registrado no provedor. Uma captura válida pode confirmar o pagamento e consumir a reserva de estoque; divergências serão encaminhadas para revisão. Não cria, reenvia ou reembolsa cobranças. Limite de cinco solicitações por minuto por administrador.</p>
            <form method="post" asp-action="Recover" asp-route-id="@payment.Id" class="mt-5 grid gap-4" aria-describedby="recovery-help">
                <input type="hidden" name="ExpectedVersion" value="@Model.ConcurrencyVersion" />
                <div>
                    <label class="block text-sm font-semibold" for="recovery-reason">Motivo da consulta</label>
                    <select id="recovery-reason" name="Reason" required class="mt-2 w-full rounded-xl border border-stone-300 bg-white px-4 py-3">
                        <option value="">Selecione o motivo</option>
                        <option value="MissingNotification">Notificação não recebida</option>
                        <option value="StatusCheck">Conferência de situação</option>
                    </select>
                </div>
                <label class="flex items-start gap-3 text-sm leading-6" for="recovery-confirm">
                    <input id="recovery-confirm" class="mt-1 size-5 shrink-0" type="checkbox" name="Confirm" value="true" required />
                    Entendo que esta consulta pode atualizar o pagamento e o estoque após validação do provedor.
                </label>
                <button type="submit" class="btn-primary">Consultar provedor e recuperar confirmação</button>
            </form>
        }
        else if (Model.RecoveryEnabled && Model.RecoveryBlockedUntilUtc is { } blockedUntil)
        {
            <p class="mt-3 text-sm leading-6 text-stone-600" role="status">Consulta em andamento. Aguarde a conclusão ou o limite de @Date(blockedUntil). Recarregue o detalhe antes de tentar novamente.</p>
        }
        else
        {
            <p class="mt-3 text-sm leading-6 text-stone-600">@(Model.RecoveryEnabled ? "Tentativa não elegível. Pagamentos já confirmados, em revisão ou sem ID externo não podem ser recuperados por esta ação." : "Recuperação desativada neste ambiente. Nenhuma consulta será enviada ao provedor.")</p>
        }
    </section>
    <section class="mt-8 rounded-3xl border border-stone-200 bg-white p-6" aria-labelledby="refund-title">
        <h2 id="refund-title" class="text-xl font-semibold">Reembolso total de teste</h2>
        <p class="mt-3 text-sm leading-6 text-stone-600">Preparar registra apenas a intenção local. Enviar exige outra confirmação e configuração Sandbox habilitada. Sucesso no envio não comprova devolução: somente consulta canônica confirma o reembolso. Estoque e cupom não são repostos automaticamente.</p>
        @if (TempData["RefundMessage"] is string refundMessage)
        {
            <p class="mt-4 rounded-xl border border-stone-300 p-4 text-sm" role="status">@refundMessage</p>
        }
        @if (Model.RefundRequest is { } refund)
        {
            <dl class="mt-5 grid gap-3 text-sm">
                <div><dt class="font-semibold">Situação</dt><dd>@PaymentLabels.RefundState(refund.State)</dd></div>
                <div><dt class="font-semibold">Identificador estável</dt><dd class="break-all">@refund.Id</dd></div>
                <div><dt class="font-semibold">Valor total</dt><dd>@refund.Amount.ToString("C") @refund.Currency</dd></div>
                <div><dt class="font-semibold">Motivo</dt><dd>@PaymentLabels.RefundReason(refund.Reason)</dd></div>
                <div><dt class="font-semibold">Registro</dt><dd>@Date(refund.CreatedAtUtc)</dd></div>
                <div><dt class="font-semibold">Início do envio</dt><dd>@Date(refund.StartedAtUtc)</dd></div>
                <div><dt class="font-semibold">Confirmação</dt><dd>@Date(refund.ConfirmedAtUtc)</dd></div>
                <div><dt class="font-semibold">Reembolso externo</dt><dd class="break-all">@(refund.ExternalRefundId ?? "Ainda não confirmado")</dd></div>
            </dl>
            <p class="mt-4 text-sm leading-6">Não altere a chave e não faça outro envio no provedor. Se houver interrupção, use apenas a consulta. Divergências ou mudanças posteriores exigem conferência; não há conclusão financeira manual.</p>
            @if (Model.RefundEnabled && refund.State is (Sallvat.Domain.Payments.PaymentRefundRequestState.Prepared or Sallvat.Domain.Payments.PaymentRefundRequestState.Sending or Sallvat.Domain.Payments.PaymentRefundRequestState.AwaitingConfirmation))
            {
                var send = refund.State == Sallvat.Domain.Payments.PaymentRefundRequestState.Prepared;
                <form method="post" asp-action="@(send ? "SendRefund" : "CheckRefund")" asp-route-id="@payment.Id" class="mt-5 grid gap-4">
                    <input type="hidden" name="ExpectedRefundVersion" value="@refund.Version" />
                    <label class="flex items-start gap-3 text-sm leading-6">
                        <input type="checkbox" name="Confirm" value="true" required class="mt-1 size-5 shrink-0" />
                        @(send ? "Confirmo o envio do reembolso total de teste ao Mercado Pago após revalidação da captura." : "Confirmo a consulta ao provedor, sem repetir o envio do reembolso.")
                    </label>
                    <button type="submit" class="btn-primary">@(send ? "Enviar reembolso total de teste" : "Consultar confirmação — sem reenviar")</button>
                </form>
            }
        }
        else if (Model.CanPrepareRefund)
        {
            <form method="post" asp-action="PrepareRefund" asp-route-id="@payment.Id" class="mt-5 grid gap-4">
                <input type="hidden" name="ExpectedVersion" value="@Model.ConcurrencyVersion" />
                <input type="hidden" name="ExpectedOrderVersion" value="@Model.OrderVersion" />
                <label class="grid gap-2 text-sm font-semibold" for="refund-reason">Motivo
                    <select id="refund-reason" name="Reason" required class="rounded-xl border border-stone-300 bg-white px-4 py-3">
                        <option value="">Selecione o motivo</option>
                        <option value="CustomerRequest">Solicitação do cliente</option>
                        <option value="FulfillmentUnavailable">Impossibilidade de atender o pedido</option>
                        <option value="OperationalCorrection">Correção operacional</option>
                    </select>
                </label>
                <label class="flex items-start gap-3 text-sm leading-6">
                    <input type="checkbox" name="Confirm" value="true" required class="mt-1 size-5 shrink-0" />
                    Confirmo apenas o registro local da intenção de reembolso total de @payment.Amount.ToString("C"). Nenhum dinheiro será devolvido nesta ação.
                </label>
                <button type="submit" class="btn-primary">Registrar intenção — sem enviar reembolso</button>
            </form>
        }
        else
        {
            <p class="mt-4 text-sm">@(Model.RefundPreparationEnabled ? "Apenas capturas Sandbox integralmente confirmadas, sem divergência, são elegíveis. Aprovações tardias, envios sem ID e revisão financeira permanecem bloqueados." : "Preparação de reembolso desativada neste ambiente.")</p>
        }
    </section>
    <h2 class="mt-10 text-xl font-semibold">Controle das execuções</h2>
    <p class="mt-3 text-sm leading-6 text-stone-600">Cada consulta tem uma janela de dois minutos. Depois dela, a resposta antiga não pode alterar pagamento ou estoque. Consultas manuais exigem confirmação explícita; consultas automáticas dependem de configuração e elegibilidade. Nenhuma recria cobrança. Registros anteriores à implantação deste controle permanecem somente na auditoria abaixo.</p>
    <p class="mt-3 text-sm leading-6 text-stone-600">Recuperação automática: @(Model.AutomaticRecoveryEnabled ? "habilitada" : "desativada"). Execuções utilizadas: @Model.AutomaticRecoveryCount de 3. Esperas mínimas: 2 minutos após o início do envio, 5 e 15 minutos após a consulta automática anterior. Janela de seleção: 24 horas após o início do envio. O limite não cancela pedidos nem comprova ausência de pagamento; pendências restantes exigem conferência manual.</p>
    <ol class="mt-5 grid gap-3">
        @foreach (var execution in Model.Executions)
        {
            <li class="rounded-xl border border-stone-200 bg-white p-4 text-sm">
                <p class="break-all">Execução @execution.Id</p>
                <p class="mt-2">@(execution.Source == Sallvat.Domain.Payments.PaymentRecoverySource.Automatic ? "Origem: sistema automático" : "Origem: administrador")</p>
                <p class="mt-2">@(execution.State == Sallvat.Domain.Payments.PaymentRecoveryExecutionState.Completed ? "Concluída — confira o resultado abaixo" : execution.State == Sallvat.Domain.Payments.PaymentRecoveryExecutionState.Interrupted ? "Interrompida — resposta antiga bloqueada" : "Sem conclusão registrada — confira o prazo antes de solicitar outra consulta")</p>
                <p class="mt-2">@PaymentLabels.ExecutionOutcome(execution.Outcome)</p>
                <p class="mt-2">Início: @Date(execution.StartedAtUtc) · limite: @Date(execution.ExpiresAtUtc)</p>
                @if (execution.FinishedAtUtc is not null)
                {
                    <p class="mt-2">Encerramento: @Date(execution.FinishedAtUtc)</p>
                }
            </li>
        }
    </ol>
    @if (Model.Executions.Count == 0)
    {
        <p class="mt-4">Nenhuma execução registrada neste controle.</p>
    }
    @if (Model.HasOlderExecutions)
    {
        <p class="mt-4">Exibindo as 20 execuções mais recentes; as anteriores permanecem preservadas.</p>
    }
    <h2 class="mt-10 text-xl font-semibold">Histórico de recuperação</h2>
    <p class="mt-3 text-sm leading-6 text-stone-600">Até 50 registros recentes. Solicitação não significa conclusão: relacione os registros pelo identificador. Uma operação pode estar em andamento ou ter sido interrompida; a ausência de conclusão não autoriza outra cobrança. Confirmações por recuperação usam esta auditoria e não geram recibo de webhook.</p>
    <ol class="mt-5 grid gap-3">
        @foreach (var entry in Model.RecoveryEntries)
        {
            <li class="rounded-xl border border-stone-200 bg-white p-4 text-sm">
                <p class="font-semibold">@(entry.IsCompletion ? "Resultado registrado" : "Solicitação registrada") — @Date(entry.CreatedAtUtc)</p>
                <p class="mt-2">@PaymentLabels.RecoveryReason(entry.Reason)</p>
                <p class="mt-2 break-all">Identificador: @(entry.RequestId?.ToString() ?? "Indisponível")</p>
                @if (entry.IsCompletion)
                {
                    <p class="mt-2">@PaymentLabels.RecoveryResult(entry.Result)</p>
                }
            </li>
        }
    </ol>
    @if (Model.RecoveryEntries.Count == 0)
    {
        <p class="mt-4">Nenhuma recuperação registrada.</p>
    }
    @if (Model.HasOlderRecoveryEntries)
    {
        <p class="mt-4">Existem registros anteriores preservados na auditoria; somente os 50 mais recentes aparecem aqui.</p>
    }
    <h2 class="mt-10 text-xl font-semibold">Recibos de webhook processados</h2>
    <p class="mt-3 text-sm text-stone-600">Até 50 recibos recentes. Falhas sem commit não aparecem aqui. Observações posteriores não apagam evidências de confirmação.</p>
    <ol class="mt-5 grid gap-3">
        @foreach (var receipt in Model.Receipts)
        {
            <li class="rounded-xl border border-stone-200 bg-white p-4 text-sm">@Date(receipt.ReceivedAtUtc) — @PaymentLabels.Receipt(receipt.Outcome)</li>
        }
    </ol>
    @if (Model.Receipts.Count == 0)
    {
        <p class="mt-4">Nenhum recibo processado registrado.</p>
    }
    @if (Model.HasOlderReceipts)
    {
        <p class="mt-4">Existem recibos anteriores preservados no banco; esta consulta exibe somente os 50 mais recentes.</p>
    }
</section>
