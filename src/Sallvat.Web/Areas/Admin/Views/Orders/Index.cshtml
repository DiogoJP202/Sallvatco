@model IReadOnlyList<AdminOrderSummary>
@{
    ViewData["Title"] = "Pedidos abertos";
}

<section class="mx-auto max-w-6xl px-6 py-12 lg:px-8 lg:py-16">
    <div>
        <p class="text-sm font-semibold tracking-[0.16em] text-stone-500 uppercase">Operação</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-stone-950">Pedidos abertos</h1>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-stone-600">Pedidos aguardando pagamento e ocorrências que exigem revisão. Toda ação exige justificativa, versão atual e gera auditoria.</p>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="mt-8 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900" role="status">@statusMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="mt-8 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900" role="alert">@errorMessage</div>
    }

    <div class="mt-8 grid gap-5">
        @foreach (var order in Model)
        {
            <article class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
                <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                    <div>
                        <div class="flex flex-wrap items-center gap-3">
                            <h2 class="text-lg font-semibold text-stone-950">@order.OrderNumber</h2>
                            <span class="rounded-full px-3 py-1 text-xs font-semibold @(order.Status == OrderStatus.RequiresAttention ? "bg-amber-100 text-amber-950" : "bg-stone-100 text-stone-700")">
                                @(order.Status == OrderStatus.RequiresAttention ? "Requer atenção" : "Aguardando pagamento")
                            </span>
                        </div>
                        <p class="mt-2 text-sm text-stone-600">@order.BuyerName · @order.GrandTotal.ToString("C")</p>
                        <p class="mt-1 text-xs text-stone-500">Criado em @order.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm 'UTC'") · reserva até @order.ExpiresAtUtc.ToString("dd/MM/yyyy HH:mm 'UTC'")</p>
                        @if (order.AttentionReason is not null)
                        {
                            <p class="mt-4 rounded-2xl bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-950"><strong>Motivo:</strong> @order.AttentionReason</p>
                        }
                    </div>
                    <div class="grid gap-3 md:w-96">
                        @if (order.CanFlagForAttention)
                        {
                            <form class="grid gap-2" asp-action="Transition" asp-route-id="@order.Id" method="post">
                                <input name="ConcurrencyVersion" type="hidden" value="@order.ConcurrencyVersion" />
                                <input name="TargetStatus" type="hidden" value="@OrderStatus.RequiresAttention" />
                                <label class="text-xs font-semibold text-stone-700" for="attention-reason-@order.Id">Enviar para revisão</label>
                                <textarea class="min-h-20 rounded-xl border border-stone-300 px-3 py-2 text-sm" id="attention-reason-@order.Id" name="Reason" maxlength="500" minlength="5" required></textarea>
                                <button class="btn-secondary" type="submit">Marcar para revisão</button>
                            </form>
                        }
                        @if (order.CanCancel)
                        {
                            <form class="grid gap-2 border-t border-stone-200 pt-3" asp-action="Transition" asp-route-id="@order.Id" method="post">
                                <input name="ConcurrencyVersion" type="hidden" value="@order.ConcurrencyVersion" />
                                <input name="TargetStatus" type="hidden" value="@OrderStatus.Cancelled" />
                                <label class="text-xs font-semibold text-stone-700" for="cancel-reason-@order.Id">Cancelar sem captura</label>
                                <textarea class="min-h-20 rounded-xl border border-stone-300 px-3 py-2 text-sm" id="cancel-reason-@order.Id" name="Reason" maxlength="500" minlength="5" required></textarea>
                                <button class="min-h-11 rounded-full border border-red-300 px-5 py-2 text-sm font-semibold text-red-800 transition hover:bg-red-50" type="submit">Cancelar e liberar reservas</button>
                            </form>
                        }
                    </div>
                </div>
            </article>
        }
        @if (Model.Count == 0)
        {
            <div class="rounded-3xl border border-dashed border-stone-300 px-6 py-16 text-center text-sm text-stone-500">Nenhum pedido aberto ou em revisão.</div>
        }
    </div>
</section>
