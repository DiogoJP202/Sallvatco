@model ProductFormViewModel
@{
    ViewData["Title"] = "Novo perfume";
}

<section class="mx-auto max-w-5xl px-5 py-12 sm:px-8 lg:px-10">
    <a class="text-sm font-semibold text-copper" asp-action="Index">← Voltar ao catálogo</a>
    <p class="eyebrow mt-8">Novo rascunho</p>
    <h1 class="mt-4 font-serif text-4xl">Cadastrar perfume</h1>
    <form class="mt-10 space-y-6 rounded-3xl border border-stone-300 bg-white p-6 sm:p-9" method="post">
        <partial name="_ProductForm" model="Model" />
        <button class="btn-primary" type="submit">Criar rascunho</button>
    </form>
</section>
