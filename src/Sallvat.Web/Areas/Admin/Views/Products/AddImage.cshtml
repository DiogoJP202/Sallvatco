@model ProductImageUploadViewModel
@{
    ViewData["Title"] = "Adicionar imagem";
}

<section class="mx-auto max-w-2xl px-5 py-12 sm:px-8">
    <a class="text-sm font-semibold text-copper" asp-action="Edit" asp-route-id="@Model.ProductId">← Voltar ao produto</a>
    <p class="eyebrow mt-8">Catálogo · @ViewData["ProductName"]</p>
    <h1 class="mt-4 font-serif text-4xl">Adicionar imagem</h1>

    <form class="mt-10 space-y-6 rounded-3xl border border-stone-300 bg-white p-6 sm:p-9"
          method="post"
          enctype="multipart/form-data">
        <input asp-for="ProductId" type="hidden" />
        <input asp-for="ConcurrencyVersion" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-700" role="alert"></div>
        <div>
            <label class="field-label" asp-for="Image"></label>
            <input class="field-input" asp-for="Image" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" />
            <span class="field-error" asp-validation-for="Image"></span>
            <p class="mt-2 text-xs leading-5 text-stone-500">JPEG, PNG ou WebP, até 10 MB e 25 megapixels. Arquivos animados são recusados.</p>
        </div>
        <div>
            <label class="field-label" asp-for="AltText"></label>
            <input class="field-input" asp-for="AltText" autocomplete="off" />
            <span class="field-error" asp-validation-for="AltText"></span>
            <p class="mt-2 text-xs leading-5 text-stone-500">Descreva objetivamente o frasco e a composição visual.</p>
        </div>
        <button class="btn-primary" type="submit">Processar e adicionar</button>
    </form>
</section>
