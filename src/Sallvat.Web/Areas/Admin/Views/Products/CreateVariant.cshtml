@model VariantFormViewModel
@{ ViewData["Title"] = "Nova variante"; }
<section class="mx-auto max-w-4xl px-5 py-12 sm:px-8 lg:px-10">
    <a class="text-sm font-semibold text-copper" asp-action="Edit" asp-route-id="@Model.ProductId">← Voltar ao produto</a>
    <p class="eyebrow mt-8">Catálogo</p><h1 class="mt-4 font-serif text-4xl">Nova variante</h1>
    <form class="mt-10 space-y-6 rounded-3xl border border-stone-300 bg-white p-6 sm:p-9" method="post"><partial name="_VariantForm" model="Model" /><button class="btn-primary" type="submit">Adicionar variante</button></form>
</section>
