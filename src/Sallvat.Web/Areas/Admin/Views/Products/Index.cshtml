@model IReadOnlyList<AdminProductSummary>
@{
    ViewData["Title"] = "Catálogo administrativo";
}

<section class="mx-auto max-w-7xl px-5 py-12 sm:px-8 lg:px-10">
    <div class="flex flex-wrap items-end justify-between gap-5">
        <div>
            <p class="eyebrow">Administração</p>
            <h1 class="mt-4 font-serif text-4xl sm:text-5xl">Catálogo</h1>
        </div>
        <a class="btn-primary" asp-action="Create">Novo perfume</a>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="mt-8 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800" role="status">@statusMessage</div>
    }

    @if (Model.Count == 0)
    {
        <div class="mt-10 rounded-3xl border border-stone-300 bg-white p-10 text-center">
            <h2 class="font-serif text-3xl">Nenhum produto cadastrado.</h2>
            <p class="mt-3 text-sm text-stone-600">Comece por um rascunho; nada será publicado automaticamente.</p>
        </div>
    }
    else
    {
        <div class="mt-10 overflow-x-auto rounded-3xl border border-stone-300 bg-white">
            <table class="w-full min-w-[48rem] text-left text-sm">
                <thead class="border-b border-stone-200 bg-stone-50 text-xs tracking-wide text-stone-500 uppercase">
                    <tr><th class="px-5 py-4">Produto</th><th class="px-5 py-4">Estado</th><th class="px-5 py-4">Variantes</th><th class="px-5 py-4">Disponível</th><th class="px-5 py-4"></th></tr>
                </thead>
                <tbody class="divide-y divide-stone-200">
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td class="px-5 py-4"><strong class="block">@product.Name</strong><span class="text-stone-500">/@product.Slug</span></td>
                            <td class="px-5 py-4">@product.Status @(product.IsFeatured ? "· destaque" : string.Empty)</td>
                            <td class="px-5 py-4">@product.VariantCount</td>
                            <td class="px-5 py-4">@product.AvailableStock</td>
                            <td class="px-5 py-4 text-right"><a class="font-semibold text-copper" asp-action="Edit" asp-route-id="@product.Id">Editar</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
