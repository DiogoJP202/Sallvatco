@model ProductFormViewModel
@{
    ViewData["Title"] = "Editar perfume";
    var product = ViewData["ProductDetails"] as AdminProductDetails;
}

<section class="mx-auto max-w-7xl px-5 py-12 sm:px-8 lg:px-10">
    <a class="text-sm font-semibold text-copper" asp-action="Index">← Voltar ao catálogo</a>
    <div class="mt-8 flex flex-wrap items-end justify-between gap-5">
        <div><p class="eyebrow">@(product?.Status.ToString() ?? "Produto")</p><h1 class="mt-4 font-serif text-4xl">@Model.Name</h1></div>
        <a class="btn-secondary" asp-action="CreateVariant" asp-route-productId="@Model.Id">Adicionar variante</a>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="mt-8 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800" role="status">@statusMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="mt-8 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-800" role="alert">@errorMessage</div>
    }

    <div class="mt-10 grid gap-8 xl:grid-cols-[minmax(0,1fr)_22rem]">
        <form class="space-y-6 rounded-3xl border border-stone-300 bg-white p-6 sm:p-9" method="post">
            <partial name="_ProductForm" model="Model" />
            <button class="btn-primary" type="submit">Salvar produto</button>
        </form>

        <aside class="space-y-6">
            <div class="rounded-3xl border border-stone-300 bg-white p-6">
                <h2 class="font-serif text-2xl">Publicação</h2>
                <dl class="mt-5 space-y-2 text-sm"><div class="flex justify-between"><dt>Imagens</dt><dd>@(product?.Images.Count ?? 0)</dd></div><div class="flex justify-between"><dt>Variantes</dt><dd>@(product?.Variants.Count ?? 0)</dd></div></dl>
                <p class="mt-4 text-xs leading-5 text-stone-500">Publicar exige conteúdo editorial, imagem e ao menos uma variante comercializável.</p>
                @if (product is not null && product.Status != ProductStatus.Archived)
                {
                    <form class="mt-5" asp-action="Publish" asp-route-id="@Model.Id" method="post"><input name="concurrencyVersion" type="hidden" value="@product.ConcurrencyVersion" /><button class="btn-primary w-full" type="submit">Publicar</button></form>
                    @if (product.Status == ProductStatus.Published)
                    {
                        <form class="mt-3" asp-action="SetFeatured" asp-route-id="@Model.Id" method="post"><input name="concurrencyVersion" type="hidden" value="@product.ConcurrencyVersion" /><input name="isFeatured" type="hidden" value="@(!product.IsFeatured)" /><button class="btn-secondary w-full" type="submit">@(product.IsFeatured ? "Remover destaque" : "Destacar")</button></form>
                    }
                    <form class="mt-3" asp-action="Archive" asp-route-id="@Model.Id" method="post"><input name="concurrencyVersion" type="hidden" value="@product.ConcurrencyVersion" /><button class="w-full py-2 text-sm font-semibold text-red-700" type="submit">Arquivar</button></form>
                }
            </div>
            <div class="rounded-3xl border border-emerald-200 bg-emerald-50 p-6 text-sm leading-6 text-emerald-900">
                As imagens são validadas pelo conteúdo, reprocessadas sem metadados e publicadas em três tamanhos WebP.
            </div>
        </aside>
    </div>

    <div class="mt-10 rounded-3xl border border-stone-300 bg-white p-6 sm:p-9">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div><p class="eyebrow">Mídia</p><h2 class="mt-3 font-serif text-3xl">Imagens</h2></div>
            @if (product is not null && product.Status != ProductStatus.Archived && product.Images.Count < 10)
            {
                <a class="btn-secondary" asp-action="AddImage" asp-route-productId="@Model.Id">Adicionar imagem</a>
            }
        </div>
        @if (product is null || product.Images.Count == 0)
        {
            <p class="mt-6 text-sm text-stone-600">Nenhuma imagem cadastrada. Uma imagem é obrigatória para publicar.</p>
        }
        else
        {
            <form class="mt-7 space-y-5" asp-action="UpdateImages" asp-route-productId="@Model.Id" method="post">
                <input name="ProductId" type="hidden" value="@Model.Id" />
                <input name="ConcurrencyVersion" type="hidden" value="@product.ConcurrencyVersion" />
                @for (var index = 0; index < product.Images.Count; index++)
                {
                    var image = product.Images[index];
                    <div class="grid gap-5 rounded-2xl border border-stone-200 p-4 sm:grid-cols-[8rem_minmax(0,1fr)_7rem] sm:items-center">
                        <img class="aspect-[4/5] w-full rounded-xl bg-sand object-cover" src="@image.ThumbnailUrl" width="@image.Width" height="@image.Height" alt="@image.AltText" loading="lazy" />
                        <div>
                            <input name="Images[@index].ImageId" type="hidden" value="@image.Id" />
                            <label class="field-label" for="image-alt-@image.Id">Texto alternativo</label>
                            <input class="field-input" id="image-alt-@image.Id" name="Images[@index].AltText" maxlength="200" required value="@image.AltText" />
                            <label class="mt-3 flex items-center gap-2 text-sm font-semibold"><input name="CoverImageId" type="radio" value="@image.Id" checked="@image.IsCover" /> Capa</label>
                        </div>
                        <div>
                            <label class="field-label" for="image-position-@image.Id">Posição</label>
                            <input class="field-input" id="image-position-@image.Id" name="Images[@index].Position" type="number" min="0" max="9" required value="@image.Position" />
                        </div>
                    </div>
                }
                <button class="btn-secondary" type="submit">Salvar ordem e capa</button>
            </form>
            <div class="mt-6 flex flex-wrap gap-3 border-t border-stone-200 pt-5">
                @foreach (var image in product.Images)
                {
                    <form asp-action="RemoveImage" asp-route-productId="@Model.Id" asp-route-imageId="@image.Id" method="post">
                        <input name="concurrencyVersion" type="hidden" value="@product.ConcurrencyVersion" />
                        <button class="text-sm font-semibold text-red-700" type="submit">Remover posição @image.Position</button>
                    </form>
                }
            </div>
        }
    </div>

    <div class="mt-10 rounded-3xl border border-stone-300 bg-white p-6 sm:p-9">
        <div class="flex items-center justify-between"><h2 class="font-serif text-3xl">Variantes</h2><a class="text-sm font-semibold text-copper" asp-action="CreateVariant" asp-route-productId="@Model.Id">Adicionar</a></div>
        @if (product is null || product.Variants.Count == 0)
        {
            <p class="mt-5 text-sm text-stone-600">Nenhuma variante cadastrada.</p>
        }
        else
        {
            <div class="mt-6 overflow-x-auto"><table class="w-full min-w-[40rem] text-left text-sm"><thead class="border-b border-stone-200 text-xs uppercase text-stone-500"><tr><th class="py-3">SKU</th><th>Volume</th><th>Preço</th><th>Estoque</th><th></th></tr></thead><tbody class="divide-y divide-stone-200">
                @foreach (var variant in product.Variants)
                {
                    <tr><td class="py-4 font-semibold">@variant.Sku</td><td>@variant.VolumeMl ml</td><td>@variant.Price.ToString("C")</td><td>@(variant.OnHand - variant.Reserved) disponível</td><td class="text-right"><a class="font-semibold text-copper" asp-action="EditVariant" asp-route-productId="@Model.Id" asp-route-variantId="@variant.Id">Editar</a><span class="mx-2 text-stone-300">|</span><a class="font-semibold text-copper" asp-action="Stock" asp-route-productId="@Model.Id" asp-route-variantId="@variant.Id">Estoque</a></td></tr>
                }
            </tbody></table></div>
        }
    </div>
</section>
