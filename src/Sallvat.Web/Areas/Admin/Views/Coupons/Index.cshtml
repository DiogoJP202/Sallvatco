@model IReadOnlyList<AdminCouponSummary>
@{
    ViewData["Title"] = "Cupons";
}

<section class="mx-auto max-w-6xl px-6 py-12 lg:px-8 lg:py-16">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-semibold tracking-[0.16em] text-stone-500 uppercase">Promoções</p>
            <h1 class="mt-3 text-3xl font-semibold tracking-tight text-stone-950">Cupons</h1>
            <p class="mt-3 max-w-2xl text-sm leading-6 text-stone-600">Códigos únicos, janela de validade e limites verificáveis. Cupons nunca são excluídos para preservar a auditoria.</p>
        </div>
        <a class="btn-primary" asp-action="Create">Novo cupom</a>
    </div>

    @if (TempData["StatusMessage"] is string status)
    {
        <div class="mt-8 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900" role="status">@status</div>
    }

    <div class="mt-8 overflow-x-auto rounded-2xl border border-stone-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-stone-200 text-left text-sm">
            <thead class="bg-stone-50 text-xs tracking-wide text-stone-500 uppercase">
                <tr>
                    <th class="px-5 py-4">Código</th>
                    <th class="px-5 py-4">Desconto</th>
                    <th class="px-5 py-4">Uso</th>
                    <th class="px-5 py-4">Validade</th>
                    <th class="px-5 py-4">Estado</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
                @foreach (var coupon in Model)
                {
                    <tr>
                        <td class="px-5 py-4"><a class="font-semibold text-stone-950 underline-offset-4 hover:underline" asp-action="Edit" asp-route-id="@coupon.Id">@coupon.Code</a></td>
                        <td class="px-5 py-4 text-stone-600">@(coupon.DiscountType == CouponDiscountType.Percentage ? $"{coupon.Value:0.##}%" : coupon.Value.ToString("C"))</td>
                        <td class="px-5 py-4 text-stone-600">@coupon.ClaimedUsageCount@(coupon.TotalUsageLimit.HasValue ? $" / {coupon.TotalUsageLimit}" : string.Empty)</td>
                        <td class="px-5 py-4 text-stone-600">@(coupon.ExpiresAtUtc?.ToString("dd/MM/yyyy HH:mm 'UTC'") ?? "Sem expiração")</td>
                        <td class="px-5 py-4"><span class="rounded-full px-3 py-1 text-xs font-semibold @(coupon.IsActive ? "bg-emerald-100 text-emerald-900" : "bg-stone-200 text-stone-700")">@(coupon.IsActive ? "Ativo" : "Inativo")</span></td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td class="px-5 py-12 text-center text-stone-500" colspan="5">Nenhum cupom cadastrado.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>
