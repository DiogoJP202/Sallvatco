{
  "name": "sallvatco",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "css:build": "tailwindcss -i ./src/Sallvat.Web/Styles/app.css -o ./src/Sallvat.Web/wwwroot/css/app.css --minify",
    "css:watch": "tailwindcss -i ./src/Sallvat.Web/Styles/app.css -o ./src/Sallvat.Web/wwwroot/css/app.css --watch",
    "lint:markdown": "node tools/lint-markdown.mjs",
    "test:tooling": "node --test tools/tests/*.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "markdownlint": "0.41.1",
    "tailwindcss": "4.3.3"
  },
  "overrides": {
    "@tailwindcss/cli": {
      "@parcel/watcher": "2.6.0"
    },
    "micromark-extension-math": {
      "katex": "0.18.2"
    }
  }
}
